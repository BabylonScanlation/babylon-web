{
  "name": "babylon-scanlation",
  "type": "module",
  "version": "2.5.5",
  "description": "Professional Edge-First Scanlation CMS built with Astro and Cloudflare.",
  "overrides": {
    "esbuild": "0.28.0",
    "fast-xml-parser": "^5.3.4",
    "lodash": "^4.17.23",
    "undici": "^7.19.2",
    "wrangler": "^4.94.0",
    "@tootallnate/once": "^3.0.1",
    "yaml": "^2.8.3",
    "drizzle-orm": "^0.45.2",
    "ws": "^8.20.1",
    "uuid": "^11.1.1"
  },
  "scripts": {
    "dev": "astro dev",
    "lint": "eslint . --cache && tsc --noEmit && biome check .",
    "format": "biome format --write .",
    "check": "npm run format && astro check && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "vite-bundle-visualizer",
    "build": "npm run format && npm run lint && astro build && node scripts/cf-postbuild.js",
    "preview": "astro build && wrangler pages dev ./dist",
    "astro": "astro",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "dev:cf": "concurrently \"wrangler pages dev --proxy 8789 --ip 0.0.0.0 --port 8788\" \"astro dev --port 8789 --host 0.0.0.0\"",
    "dev:remote": "concurrently \"wrangler pages dev --proxy 8789 --ip 0.0.0.0 --port 8788 --remote\" \"astro dev --port 8789 --host 0.0.0.0\"",
    "start": "astro start",
    "db:pull": "node scripts/db-export-custom.js",
    "db:reset:local": "node -e \"require('fs').rmSync('.wrangler/state/v3/d1', { recursive: true, force: true })\"",
    "db:load": "wrangler d1 execute babylon-scanlation-prod --local --file=./db_snapshots/dump.sql",
    "db:migrate": "wrangler d1 migrations apply babylon-scanlation-prod --local",
    "db:offline": "npm run db:migrate && npm run db:load && npm run dev:cf",
    "db:online": "node scripts/db-sync.js",
    "db:purge": "node scripts/purge-utils.js --users",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate:local": "drizzle-kit migrate:sqlite",
    "db:push": "drizzle-kit push:sqlite",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,astro,svelte}": [
      "biome check --write"
    ]
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^13.5.2",
    "@astrojs/db": "^0.21.2",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/svelte": "^8.1.1",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@zip.js/zip.js": "^2.8.26",
    "astro": "^6.3.5",
    "chart.js": "^4.5.1",
    "cropperjs": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.9.0",
    "jose": "^6.2.3",
    "p-limit": "^7.3.0",
    "snarkdown": "^2.0.0",
    "svelte": "^5.55.5",
    "swiper": "^12.1.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@cloudflare/workers-types": "^4.20260511.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/cropperjs": "^1.3.3",
    "@types/node": "^25.7.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@upstash/context7-mcp": "^2.2.5",
    "astro-eslint-parser": "^1.4.0",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "svelte-check": "^4.4.8",
    "svelte-eslint-parser": "^1.6.1",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6",
    "wrangler": "^4.94.0"
  }
}
