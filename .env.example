# === PUBLIC CONFIG EXAMPLE (.env.example) ===
# Estas variables están expuestas al cliente (Astro SSR/Static).
# Renombra este archivo a .env y rellena con tus datos reales.

# --- FIREBASE (Cliente) ---
PUBLIC_FIREBASE_API_KEY="your_api_key_here"
PUBLIC_FIREBASE_PROJECT_ID="your_project_id_here"
PUBLIC_FIREBASE_AUTH_DOMAIN="your_project.firebaseapp.com"
PUBLIC_FIREBASE_STORAGE_BUCKET="your_project.firebasestorage.app"
PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id_here"
PUBLIC_FIREBASE_APP_ID="your_app_id_here"

# --- CLOUDFLARE TURNSTILE (Captcha) ---
PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAA..."
PUBLIC_TURNSTILE_DEV_SITE_KEY="1x00000000000000000000AA"

# --- REDES DE PUBLICIDAD (Opcional) ---

# Adsterra
PUBLIC_ADSTERRA_DOMAIN="your_domain_here"
PUBLIC_ADSTERRA_BANNER_ID="your_ad_id_here"
PUBLIC_ADSTERRA_BANNER_LARGE_ID="your_ad_id_here"
PUBLIC_ADSTERRA_BANNER_SMALL_ID="your_ad_id_here"
PUBLIC_ADSTERRA_SQUARE_ID="your_ad_id_here"
PUBLIC_ADSTERRA_NATIVE_ID="your_ad_id_here"
PUBLIC_ADSTERRA_SOCIAL_BAR_URL="your_social_bar_url_here"
PUBLIC_ADSTERRA_POPUNDER_URL="your_popunder_url_here"
ADSTERRA_SMARTLINK_EXTRA="your_smartlink_url_here"

# Monetag
PUBLIC_MONETAG_VIGNETTE_ID="your_vignette_id_here"
PUBLIC_MONETAG_VIGNETTE_URL="your_vignette_url_here"
PUBLIC_MONETAG_MULTITAG_ID="your_multitag_id_here"
PUBLIC_MONETAG_MULTITAG_URL="your_multitag_url_here"
PUBLIC_MONETAG_MULTITAG_2_ID="your_multitag_2_id_here"
PUBLIC_MONETAG_MULTITAG_2_URL="your_multitag_2_url_here"
PUBLIC_MONETAG_SMARTLINK_URL="your_smartlink_url_here"
PUBLIC_MONETAG_SMARTLINK_2_URL="your_smartlink_2_url_here"
PUBLIC_MONETAG_SMARTLINK_3_URL="your_smartlink_3_url_here"