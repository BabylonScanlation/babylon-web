---
import { env } from 'cloudflare:workers';
import AdContainer from '../../components/AdContainer.astro';
import AdminSeriesNewsForm from '../../components/AdminSeriesNewsForm.astro';
import ChapterList from '../../components/ChapterList.astro';
import FavoriteButton from '../../components/FavoriteButton.svelte';
import Image from '../../components/Image.astro';
import NewsFeed from '../../components/NewsFeed.astro';
import UnifiedComments from '../../components/UnifiedComments.astro';
import Layout from '../../layouts/Layout.astro';
import { getCommentsForTarget } from '../../lib/data/comments';
import { getSeriesDetails } from '../../lib/data/series';
import { getDB } from '../../lib/db';
import { logError } from '../../lib/logError';
import { formatFullDate, getImageUrl } from '../../lib/utils';
import { siteConfig } from '../../site.config';
import type { Comment, SeriesDetails } from '../../types';

const typeMap: Record<string, string> = {
  'anime': 'Anime',
  'manga': 'Manga',
  'manhwa': 'Manhwa',
  'manhua': 'Manhua',
  'comic': 'Cómic',
  'novel': 'Novela',
  'ova': 'OVA',
  'movie': 'Película',
};

const statusMap: Record<string, string> = {
  'completed': 'Completado',
  'ongoing': 'En Emisión',
  'dropped': 'Abandonado',
  'hiatus': 'Pausado',
  'live': 'En Vivo',
};

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');

const user = Astro.locals.user;
const r2PublicUrlAssets = env?.R2_PUBLIC_URL_ASSETS;
const drizzleDb = getDB(env);

let series: SeriesDetails | null = null;
let comments: Comment[] = [];
let error: string | null = null;

try {
  series = await getSeriesDetails(
    drizzleDb,
    slug,
    user ? { uid: user.uid, isAdmin: !!user.isAdmin } : undefined
  );

  if (series) {
    // Astra: Validación de modo NSFW global vía cookies (Header Logo)
    const nsfwCookieValue = Astro.cookies.get('babylon_nsfw')?.value;
    const allowNsfw =
      typeof nsfwCookieValue === 'string' ? nsfwCookieValue === 'true' : user?.isNsfw || false;

    if (series.isNsfw && !allowNsfw) {
      return Astro.redirect('/?nsfw_required=true');
    }

    const rawComments = await getCommentsForTarget(drizzleDb, 'series', series.id, user?.uid);
    // Orion: Los comentarios ya vienen normalizados como timestamps numéricos desde el servicio
    comments = rawComments;
  } else {
    error = `Serie no encontrada.`;
  }
} catch (e) {
  logError(e, 'Error cargando serie', { slug });
  error = 'Error de conexión.';
}

// Orion: Evitar caché de Cloudflare para mostrar vistas reales instantáneamente
Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate');

const formatDescription = (text: string | null | undefined) => {
  if (!text) return '';
  return text
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\*(.*?)\*/g, '<i>$1</i>');
};

const initialState = {
  userVote: series?.stats.userVote ?? null,
  userReaction: series?.stats.userReaction ?? null,
  isLoggedIn: !!user,
};

const stars = [1, 2, 3, 4, 5];
const reactions = [
  { emoji: '😀', id: 'love' },
  { emoji: '😊', id: 'like' },
  { emoji: '🤔', id: 'interesting' },
  { emoji: '😟', id: 'dislike' },
  { emoji: '😠', id: 'hate' },
];
---

<Layout 
  title={`Leer ${series?.title ?? 'Serie'} Manga Online en Español - ${siteConfig.name}`}
  description={`Lee ${series?.title} online en español con la mejor calidad. ${series?.description?.substring(0, 140).replace(/\*/g, '') ?? ''}... ¡Solo en ${siteConfig.name}!`}
  ogImage={getImageUrl(series?.coverImageUrl, r2PublicUrlAssets, 'series')}
  isNsfwContent={series?.isNsfw || false}
>
  <!-- SEO: Datos Estructurados JSON-LD -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Book",
    "name": series?.title,
    "description": series?.description?.replace(/\*/g, ''),
    "image": getImageUrl(series?.coverImageUrl, r2PublicUrlAssets, 'series'),
    "author": {
      "@type": "Person",
      "name": series?.author || "Desconocido"
    },
    "publisher": {
      "@type": "Organization",
      "name": siteConfig.name,
      "logo": {
        "@type": "ImageObject",
        "url": siteConfig.url + siteConfig.assets.logo
      }
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": series?.stats.averageRating || 0,
      "reviewCount": series?.stats.totalVotes || 1
    }
  })} />

  <h1 class="sr-only">{series?.title}</h1>
  {
    series && (
      <main 
        class="series-minimal-page" 
        data-series-id={series.id}
        data-initial-state={JSON.stringify(initialState)}
      >
        <div class="series-content-grid">
          <!-- Sidebar: Reactions & Poster -->
          <aside class="compact-sidebar">
            <div class="reactions-top-bar">
              {reactions.map((r) => (
                <div class="react-mini-item">
                  <button
                    class:list={['react-mini-btn', { selected: series.stats.userReaction === r.emoji }]}
                    data-emoji={r.emoji}
                    data-open-modal={!user ? "login" : undefined}
                  >{r.emoji}</button>
                  <span class="react-mini-count">{series.stats.reactionCounts[r.emoji] || 0}</span>
                </div>
              ))}
            </div>

            <div class="poster-container">
              <Image 
                src={getImageUrl(series.coverImageUrl, r2PublicUrlAssets, 'series')} 
                alt={series.title} 
                class="compact-poster" 
                width={280}
                height={420}
              />
              {series.isAppSeries && (
                <button id="download-app-btn" class="compact-app-btn" title="Descargar App">
                  <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.5" fill="none"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                  App {siteConfig.shortName}
                </button>
              )}
            </div>
          </aside>

          <!-- Main Content -->
          <div class="main-info-area">
            <header class="compact-header">
              <div class="badge-row">
                <FavoriteButton
                  client:visible
                  seriesId={series.id}
                  initialIsFavorite={series?.stats?.isFavorited || false}
                  isLoggedIn={!!user}
                />

                <div class="rating-inline-header">
                  <div class="stars-row-minimal">
                    {stars.map((star) => (
                      <button class="star-mini" data-value={star} data-open-modal={!user ? "login" : undefined}>☆</button>
                    ))}
                  </div>
                  <div class="rating-text-minimal">
                    <span class="rating-avg">{series.stats.averageRating.toFixed(1)}</span>
                    <span class="rating-count">({series.stats.totalVotes})</span>
                  </div>
                </div>

                {series.status && <span class="mini-badge accent">{statusMap[series.status] || series.status}</span>}
                {series.type && <span class="mini-badge">{typeMap[series.type] || series.type}</span>}

                <div class="mini-badge views-badge">
                  <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="3" fill="none"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                  <span>{series.views?.toLocaleString() || 0}</span>
                </div>
              </div>

              <h1>{series.title}</h1>
              {series.alternativeNames && <p class="alt-titles">{series.alternativeNames}</p>}
            </header>

            <nav class="minimal-tabs">
              <button class="tab-link active" data-tab="chapters">{series.type === 'anime' || series.type === 'ova' || series.type === 'movie' ? 'Episodios' : 'Capítulos'}</button>
              <button class="tab-link" data-tab="details">Detalles</button>
              <button class="tab-link" data-tab="synopsis">Sinopsis</button>
              <button class="tab-link" data-tab="comments">
                Comentarios
                <span class="tab-count">{comments.length}</span>
              </button>
              <button class="tab-link" data-tab="news">Noticias</button>
            </nav>

            <div class="tab-panes">
              <!-- CAPÍTULOS -->
              <div id="chapters-content" class="tab-pane active">
                <ChapterList 
                  chaptersByLanguage={series.chaptersByLanguage as any} 
                  seriesSlug={series.slug} 
                  seriesIsUpToDate={!!(series as any).isUpToDate}
                  seriesType={series.type || undefined}
                />
              </div>

              <!-- DETALLES -->
              <div id="details-content" class="tab-pane">
                <div class="details-list">
                  {series.author && (
                    <div class="detail-row">
                      <span class="label">Autor</span>
                      <span class="value">{series.author}</span>
                    </div>
                  )}
                  {series.artist && (
                    <div class="detail-row">
                      <span class="label">Artista</span>
                      <span class="value">{series.artist}</span>
                    </div>
                  )}
                  {series.demographic && (
                    <div class="detail-row">
                      <span class="label">Demografía</span>
                      <span class="value">{series.demographic}</span>
                    </div>
                  )}
                  {series.genres && (
                    <div class="detail-row">
                      <span class="label">Géneros</span>
                      <div class="tags">
                        {series.genres.split(',').map((g: string) => (
                          <span class="tag-mini">{g.trim()}</span>
                        ))}
                      </div>
                    </div>
                  )}
                  {series.publishedBy && (
                    <div class="detail-row">
                      <span class="label">Editorial</span>
                      <span class="value">{series.publishedBy}</span>
                    </div>
                  )}
                  {series.serializedBy && (
                    <div class="detail-row">
                      <span class="label">Revista / Sitio</span>
                      <span class="value">{series.serializedBy}</span>
                    </div>
                  )}
                  <div class="detail-row">
                    <span class="label">Publicado</span>
                    <span class="value">{formatFullDate(series.createdAt)}</span>
                  </div>
                </div>
              </div>

              <!-- SINOPSIS -->
              <div id="synopsis-content" class="tab-pane">
                <div class="synopsis-text">
                  <p set:html={formatDescription(series.description)} />
                </div>
              </div>

              <!-- COMENTARIOS -->
              <div id="comments-content" class="tab-pane">
                <div class="comments-container-glass">
                  <UnifiedComments targetType="series" targetId={series.id} comments={comments} user={user ?? null} />
                </div>
              </div>

              <!-- NOTICIAS -->
              <div id="news-content" class="tab-pane">
                {user?.isAdmin && (
                  <AdminSeriesNewsForm
                    seriesId={series.id}
                    seriesTitle={series.title}
                    userName={user.username || user.displayName || 'Staff'}
                    seriesCover={getImageUrl(series.coverImageUrl, r2PublicUrlAssets, 'series')}
                  />
                )}
                <div class="news-feed-container">
                  <NewsFeed seriesId={series.id} user={user} />
                </div>
              </div>
            </div>

            {!Astro.locals.isStaff && !user?.isAdmin && siteConfig.ads.enabled && (
              <div class="series-bottom-ad-wrapper">
                <AdContainer type="banner" className="series-mid-ad" />
              </div>
            )}
          </div>
        </div>

        <!-- Download Modal Minimal -->
        <div id="download-modal" class="modal-overlay-minimal" style="display: none;">
          <div class="modal-card-minimal">
            <h3>App {siteConfig.shortName}</h3>
            <p>Descarga el APK oficial para Android.</p>
            <div class="modal-actions">
              <a href={siteConfig.app.androidUrl} download class="btn-download">
                <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2.5" fill="none"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                Descargar ahora
              </a>
              <button id="cancel-download-btn" class="btn-close">Tal vez luego</button>
            </div>
          </div>
        </div>
      </main>
    )
  }
  {
    !series && error && (
      <div class="error-container-full">
        <div class="error-box-glass">
          <svg viewBox="0 0 24 24" width="64" height="64" stroke="currentColor" stroke-width="1.5" fill="none"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          <h2>Lo sentimos</h2>
          <p>{error}</p>
          <a href="/" class="btn-back-home">Volver al Inicio</a>
        </div>
      </div>
    )
  }
</Layout>

<script>
  import { actions } from 'astro:actions';

  function init() {
    const main = document.querySelector('.series-minimal-page') as HTMLElement;
    if (!main) return;

    const seriesId = parseInt(main.dataset.seriesId || '0', 10);
    const stateStr = main.dataset.initialState;
    const state = stateStr ? JSON.parse(stateStr) : null;

    if (!state) return;

    const tabs = document.querySelectorAll('.tab-link');
    const panes = document.querySelectorAll('.tab-pane');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        const target = tab.getAttribute('data-tab');
        panes.forEach((p) => p.classList.toggle('active', p.id === `${target}-content`));
      });
    });

    if (seriesId) {
      actions.series.registerView({ seriesId }).catch(() => {});
    }

    const stars = document.querySelector('.stars-row-minimal');
    if (stars) {
      if (state.isLoggedIn) {
        const update = (v: number | null) => stars.querySelectorAll('.star-mini').forEach((s, i) => s.classList.toggle('filled', i < (v || 0)));
        update(state.userVote);

        stars.addEventListener('mouseover', (e) => {
          const target = e.target as HTMLElement;
          const s = target.closest('.star-mini') as HTMLElement;
          if (s) update(parseInt(s.dataset.value || '0'));
        });

        stars.addEventListener('mouseleave', () => update(state.userVote));

        stars.addEventListener('click', async (e) => {
          const target = e.target as HTMLElement;
          const s = target.closest('.star-mini') as HTMLElement;
          if (!s) return;
          const v = parseInt(s.dataset.value || '0');
          const nv = state.userVote === v ? null : v;
          state.userVote = nv;
          update(nv);

          const { data, error } = await actions.user.rateSeries({ seriesId, rating: nv || 0 });       
          if (!error && data) {
            const avgEl = document.querySelector('.rating-avg');
            const countEl = document.querySelector('.rating-count');
            if (avgEl) avgEl.textContent = data.newAverage.toFixed(1);
            if (countEl) countEl.textContent = `(${data.newCount})`;
          }
        });
      } else {
        stars.addEventListener('click', () => {
          window.dispatchEvent(new CustomEvent('open-auth-modal', { detail: { view: 'login' } }));  
        });
      }
    }

    const reacts = document.querySelector('.reactions-top-bar');
    if (reacts) {
      if (state.isLoggedIn) {
        reacts.addEventListener('click', async (e) => {
          const target = e.target as HTMLElement;
          const b = target.closest('.react-mini-btn') as HTMLElement;
          if (!b) return;
          const emoji = b.dataset.emoji || '';
          const old = state.userReaction;
          const nv = old === emoji ? null : emoji;
          state.userReaction = nv;

          reacts.querySelectorAll('.react-mini-btn').forEach(btn => {
            const btnEl = btn as HTMLElement;
            btnEl.classList.toggle('selected', btnEl.dataset.emoji === nv);
          });

          reacts.querySelectorAll('.react-mini-item').forEach(item => {
            const itemEl = item as HTMLElement;
            const btn = itemEl.querySelector('.react-mini-btn') as HTMLElement;
            const countEl = itemEl.querySelector('.react-mini-count') as HTMLElement;
            let c = parseInt(countEl.textContent || '0');
            if (btn.dataset.emoji === old) c = Math.max(0, c - 1);
            if (btn.dataset.emoji === nv) c += 1;
            countEl.textContent = c.toString();
          });

          await actions.series.react({ seriesId, emoji: nv });
        });
      } else {
        reacts.addEventListener('click', () => {
          window.dispatchEvent(new CustomEvent('open-auth-modal', { detail: { view: 'login' } }));  
        });
      }
    }

    const modal = document.getElementById('download-modal');
    document.getElementById('download-app-btn')?.addEventListener('click', () => {
      if (modal) modal.style.display = 'flex';
    });
    document.getElementById('cancel-download-btn')?.addEventListener('click', () => {
      if (modal) modal.style.display = 'none';
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const trigger = target.closest('.app-locked-trigger');
      if (trigger && modal) {
        e.preventDefault();
        modal.style.display = 'flex';
      }
    });

    window.addEventListener('comment-count-change', (e: any) => {
      const { count, targetId: id, targetType: type } = e.detail;
      if (type === 'series' && parseInt(id) === seriesId) {
        const countEl = document.querySelector('.tab-link[data-tab="comments"] .tab-count');
        if (countEl) countEl.textContent = count.toString();
      }
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .series-minimal-page {
    width: 100%;
    margin: 0;
    padding-top: 20px !important;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    padding-bottom: 0;
    box-sizing: border-box;
  }

  .series-content-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    align-items: start;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  /* Sidebar: Reactions + Poster */
  .compact-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    align-self: start;
  }

  .poster-container {
    width: 100%;
    max-width: 280px;
    border-radius: 12px;
    overflow: hidden;
    background: #111;
    border: 1px solid #222;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }

  .reactions-top-bar {
    display: flex;
    justify-content: space-between;
    background: #111;
    border: 1px solid #222;
    border-radius: 12px;
    padding: 0.6rem;
    width: 100%;
    max-width: 280px;
  }

  .react-mini-item { display: flex; flex-direction: column; align-items: center; gap: 2px; }
  .react-mini-btn {
    background: none;
    border: none;
    font-size: 1.1rem;
    cursor: pointer;
    filter: grayscale(1);
    opacity: 0.4;
    transition: all 0.2s;
    padding: 0;
  }
  .react-mini-btn:hover, .react-mini-btn.selected { filter: grayscale(0); opacity: 1; transform: scale(1.1); }
  .react-mini-count { font-size: 0.65rem; color: #555; font-weight: 800; }

  .compact-poster {
    width: 100%;
    aspect-ratio: 2/3;
    object-fit: cover;
    display: block;
  }

  .compact-app-btn {
    width: 100%;
    background: #1a1a1a;
    border: none;
    border-top: 1px solid #222;
    color: var(--accent-color);
    padding: 0.75rem;
    font-size: 0.8rem;
    font-weight: 800;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: background 0.2s;
  }

  .compact-app-btn:hover { background: #222; }

  /* Main Area Header */
  .main-info-area {
    min-width: 0;
    flex: 1;
    width: 100%;
    box-sizing: border-box;
  }
  .compact-header { margin-bottom: 1rem !important; min-width: 0; width: 100%; }
  .badge-row { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem !important; flex-wrap: wrap; }
  .mini-badge { font-size: 0.65rem; font-weight: 800; padding: 2px 8px; border-radius: 4px; background: #1a1a1a; color: #888; border: 1px solid #222; text-transform: uppercase; }
  .mini-badge.accent { color: var(--accent-color); border-color: rgba(0, 191, 255, 0.3); background: rgba(0, 191, 255, 0.05); }
  .mini-badge.views-badge { display: flex; align-items: center; gap: 5px; color: #777; }
  .mini-badge.views-badge svg { color: #555; }

  .rating-inline-header { display: flex; align-items: center; gap: 0.75rem; background: rgba(255, 255, 255, 0.02); padding: 4px 10px; border-radius: 8px; border: 1px solid #1a1a1a; }
  .stars-row-minimal { display: flex; gap: 2px; }
  .star-mini {
    background: none;
    border: none;
    color: #444;
    font-size: 1.1rem;
    cursor: pointer;
    padding: 0;
    line-height: 1;
  }
  .star-mini.filled { color: #ffc107; }
  .rating-text-minimal { font-size: 0.8rem; font-weight: 700; color: #555; display: flex; align-items: baseline; gap: 4px; }
  .rating-avg { color: #aaa; }

  .compact-header h1 {
    font-size: 2.2rem;
    font-weight: 900;
    color: #fff;
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.02em;
    overflow-wrap: break-word;
    word-break: break-word;
    hyphens: auto;
  }
  .alt-titles {
    font-size: 0.95rem;
    color: #444;
    margin-top: 0.25rem !important;
    font-weight: 500;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  /* Tabs */
  .minimal-tabs { display: flex; gap: 1.25rem; border-bottom: 1px solid #1a1a1a; margin-bottom: 1rem !important; overflow-x: auto; }
  .tab-link {
    background: none;
    border: none;
    color: #555;
    padding: 0.5rem 0 !important;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .tab-link:hover { color: #aaa; }
  .tab-link.active { color: #fff; border-bottom-color: var(--accent-color); }

  .tab-count {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font-size: 0.65rem;
    padding: 1px 6px;
    border-radius: 10px;
    font-weight: 800;
  }
  .tab-link.active .tab-count {
    background: var(--accent-color);
    color: #000;
  }

  .tab-panes {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    min-height: auto;
    margin-top: 1rem !important;
  }
  .tab-pane { display: none; width: 100%; min-width: 0; box-sizing: border-box; }
  .tab-pane.active { display: block; animation: fadeIn 0.3s ease; }

