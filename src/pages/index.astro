---
import { env } from 'cloudflare:workers';
import AdContainer from '../components/AdContainer.astro';
import FeaturedGrid from '../components/FeaturedGrid.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import RecentUpdatesGrid from '../components/RecentUpdatesGrid.astro';
import Layout from '../layouts/Layout.astro';
import { getHomeData } from '../lib/data/series';
import { getDB } from '../lib/db';
import { logError } from '../lib/logError';
import { siteConfig } from '../site.config';

const r2PublicUrlAssets = env.R2_PUBLIC_URL_ASSETS;

// Astra: El modo NSFW ahora es global vía cookies (Exclusivo)
const allowNsfw = Astro.cookies.get('babylon_nsfw')?.value === 'true';

let popularSeries: any[] = [];
let seriesByChapterCount: any[] = [];
let seriesWithRecentChapters: any[] = [];
let hasContent = false;

try {
  const db = getDB(env);

  // Orion: Carga ultra-optimizada en un solo paso
  const homeData = await getHomeData(db, allowNsfw);

  popularSeries = homeData.popularSeries as any;
  seriesByChapterCount = homeData.seriesByChapterCount as any;
  seriesWithRecentChapters = homeData.seriesWithRecentChapters;
  hasContent = homeData.hasContent;
} catch (error) {
  console.error('🔥 ERROR CRÍTICO EN HOME:', error);
  logError(error, 'Error al obtener las listas de series (Ultra Optimizado)');
}

// Orion: Para el FeaturedGrid usamos directamente las series populares
const featuredGridData = popularSeries.slice(0, 20);

// Orion: Garantizamos que la cuadrícula esté siempre ordenada por vistas (descendente)
featuredGridData.sort((a, b) => (b.views || 0) - (a.views || 0));
---

<Layout
  title={`${siteConfig.name} - Leer Manga, Manhwa y Manhua Online Gratis`}
  description={`La mejor plataforma para leer Manga, Manhwa y Manhua online en español. Capítulos diarios, alta calidad visual y la mejor comunidad. ¡Lee gratis ahora en ${siteConfig.shortName}!`}
>
  <h1 class="sr-only" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0;">
    {siteConfig.name} - Tu plataforma premium para leer Manga, Manhwa y Manhua online gratis
  </h1>
  {
    hasContent ? (
      <div class="main-content-wrapper">
          {seriesByChapterCount.length > 0 && (
            <HeroCarousel 
              slides={seriesByChapterCount} 
              r2PublicUrlAssets={r2PublicUrlAssets} 
            />
          )}

          <div class="maintenance-alert-banner">
            <div class="alert-content">
              <div class="alert-icon-container">
                <svg viewBox="0 0 24 24" width="26" height="26" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" class="alert-icon">
                  <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                  <line x1="12" y1="9" x2="12" y2="13"></line>
                  <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
              </div>
              <div class="alert-text-container">
                <p>Para cubrir los gastos de infraestructura y seguir trayéndoles todo el contenido sin interrupciones, <strong>nos faltan <span class="highlight-amount">$45</span> USD</strong> este mes.</p>
                <div class="progress-bar-bg">
                  <div class="progress-bar-fill"></div>
                </div>
              </div>
              <a href="#" class="support-btn" onclick="window.dispatchEvent(new CustomEvent('open-support-modal')); return false;">
                Apoyar
                <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </a>
            </div>
          </div>

        <div class="main-sections-container">
          {!Astro.locals.isStaff && !Astro.locals.user?.isAdmin && (
            <div class="top-ad-banner">
              <AdContainer type="bannerLarge" />
            </div>
          )}

          {featuredGridData.length > 0 && (
            <div class="featured-grid-wrapper">
              <FeaturedGrid mangas={featuredGridData.map((m) => ({...m, loading: 'lazy'}))} />
            </div>
          )}

          {!Astro.locals.isStaff && !Astro.locals.user?.isAdmin && (
            <div class="middle-ad-wrapper">
              <AdContainer type="bannerSmall" />
            </div>
          )}

          <div class="discovery-zone">
            {seriesWithRecentChapters.length > 0 && (
              <RecentUpdatesGrid
                mangas={seriesWithRecentChapters}
                title="Últimos Capítulos Publicados"
              />
            )}
          </div>

          {!Astro.locals.isStaff && !Astro.locals.user?.isAdmin && (
            <div class="bottom-ad-wrapper">
              <AdContainer type="square" />
            </div>
          )}
        </div>
      </div>
    ) : (
      <div class="empty-state-container">
        <img
          src={
            siteConfig.assets.logoEmpty.startsWith('/')
              ? `${r2PublicUrlAssets}${siteConfig.assets.logoEmpty}`
              : siteConfig.assets.logoEmpty
          }
          alt={`${siteConfig.name} Logo`}
          class="empty-state-logo"
        />
        <p class="empty-state-text">
          Lo sentimos... aún no hay series disponibles.
          <br />
          Vuelva en otro momento.
        </p>
      </div>
    )
  }
</Layout>

<style is:inline>
  /* index.astro Styles */
  .maintenance-alert-banner {
    width: 100%;
    max-width: 1400px;
    margin: 1.5rem auto 0.5rem auto;
    padding: 0 1.5rem;
    box-sizing: border-box;
    animation: fade-in-up 0.6s ease-out;
  }
  .maintenance-alert-banner .alert-content {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background: linear-gradient(135deg, rgba(255, 140, 0, 0.08) 0%, rgba(255, 60, 0, 0.12) 100%);
    border: 1px solid rgba(255, 120, 0, 0.2);
    border-radius: 16px;
    padding: 1.2rem 1.8rem;
    box-shadow: 0 10px 30px rgba(255, 100, 0, 0.08), inset 0 0 20px rgba(255, 140, 0, 0.05);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    position: relative;
    overflow: hidden;
  }
  
  .maintenance-alert-banner .alert-content::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 4px; height: 100%;
    background: linear-gradient(to bottom, #ffaa00, #ff5500);
    border-radius: 4px 0 0 4px;
  }

  .alert-icon-container {
    flex-shrink: 0;
    width: 48px; height: 48px;
    border-radius: 50%;
    background: rgba(255, 140, 0, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 140, 0, 0.3);
    animation: pulse-icon 2s infinite;
  }

  .maintenance-alert-banner .alert-icon {
    color: #ffaa00;
    filter: drop-shadow(0 0 8px rgba(255, 140, 0, 0.6));
  }
  
  @keyframes pulse-icon {
    0% { box-shadow: 0 0 0 0 rgba(255, 140, 0, 0.4); }
    70% { box-shadow: 0 0 0 10px rgba(255, 140, 0, 0); }
    100% { box-shadow: 0 0 0 0 rgba(255, 140, 0, 0); }
  }

  .alert-text-container {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .maintenance-alert-banner p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.5;
    color: #ddd;
    font-weight: 400;
  }
  
  .maintenance-alert-banner strong {
    color: #fff;
    font-weight: 600;
  }
  
  .highlight-amount {
    color: #ffaa00;
    font-weight: 900;
    font-size: 1.2rem;
    text-shadow: 0 0 15px rgba(255, 170, 0, 0.4);
    letter-spacing: 0.5px;
  }

  .progress-bar-bg {
    width: 100%;
    height: 6px;
    background: rgba(0, 0, 0, 0.4);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: inset 0 1px 3px rgba(0,0,0,0.5);
  }

  .progress-bar-fill {
    width: 40%;
    height: 100%;
    background: linear-gradient(90deg, #ff5500, #ffaa00);
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(255, 170, 0, 0.5);
  }

  .support-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #ffaa00, #ff5500);
    color: #000;
    font-weight: 800;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 0.8rem 1.5rem;
    border-radius: 100px;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(255, 140, 0, 0.3);
    flex-shrink: 0;
  }

  .support-btn:hover {
    transform: translateY(-2px) scale(1.05);
    box-shadow: 0 8px 25px rgba(255, 140, 0, 0.5);
    color: #000;
  }

  @media (max-width: 768px) {
    .maintenance-alert-banner .alert-content {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
      padding: 1.5rem 1rem;
    }
    .maintenance-alert-banner .alert-content::before {
      width: 100%; height: 4px;
      border-radius: 4px 4px 0 0;
    }
    .support-btn {
      width: 100%;
      justify-content: center;
    }
  }

  .main-content-wrapper {
    width: 100%;
  }
  .top-ad-banner {
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 0;
    margin: 0 0 1rem 0; /* Astra: Añadido margen inferior. El superior lo da main-sections-container */
    background: transparent;
    line-height: normal;
    height: auto;
    /* Astra: Eliminamos min-height para que no ocupe espacio si no hay contenido aún */
    transition: height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }  .main-sections-container {
    width: 100%;
    padding: 0 1.5rem;
    box-sizing: border-box;
    overflow-x: hidden;
    display: flex;
    flex-direction: column;
    gap: 1rem; /* Astra: Espaciado global más ajustado */
    margin-top: 0.5rem; /* Reducido para acercar al carrusel */
  }

  .featured-grid-wrapper,
  .middle-ad-wrapper,
  .discovery-zone,
  .bottom-ad-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    margin: 0;
    padding: 0;
  }

  .discovery-zone {
    flex-direction: column;
    margin-top: -0.5rem; /* Astra: Compensación para "pegar" el título al anuncio superior */
  }

  .empty-state-container {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
    padding: 1rem;
  }

  .empty-state-logo {
    max-width: 500px;
    width: 80%;
    opacity: 0.8;
    filter: drop-shadow(0 0 30px rgba(0, 191, 255, 0.2));
    animation: pulse-logo 4s ease-in-out infinite;
  }

  @keyframes pulse-logo {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.8;
    }
    50% {
      transform: scale(1.05);
      opacity: 1;
    }
  }

  .empty-state-text {
    color: #aaa;
    font-size: 1.1rem;
    max-width: 400px;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .main-sections-container {
      gap: 1.5rem;
    }
  }
</style>
