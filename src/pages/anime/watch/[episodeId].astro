---
import { env } from 'cloudflare:workers';
import { eq } from 'drizzle-orm';
import { chapters, episodeServers, series } from '../../../db/schema';
import Layout from '../../../layouts/Layout.astro';
import { getDB } from '../../../lib/db';
import { siteConfig } from '../../../site.config';

const { episodeId } = Astro.params;
if (!episodeId || isNaN(Number(episodeId))) {
  return Astro.redirect('/404');
}

const db = getDB(env);

const chapterData = await db
  .select({
    id: chapters.id,
    chapterNumber: chapters.chapterNumber,
    title: chapters.title,
    seriesId: chapters.seriesId,
    seriesTitle: series.title,
    seriesSlug: series.slug,
    seriesCover: series.coverImageUrl,
  })
  .from(chapters)
  .innerJoin(series, eq(chapters.seriesId, series.id))
  .where(eq(chapters.id, Number(episodeId)))
  .get();

if (!chapterData) return Astro.redirect('/404');

const servers = await db
  .select()
  .from(episodeServers)
  .where(eq(episodeServers.chapterId, Number(episodeId)))
  .orderBy(episodeServers.displayOrder)
  .all();

const defaultServerUrl = servers.length > 0 && servers[0] ? servers[0].iframeUrl : '';
const pageTitle = chapterData.title || `Episodio ${chapterData.chapterNumber}`;
---

<Layout
  title={`${chapterData.seriesTitle} - ${pageTitle} - ${siteConfig.name}`}
  description={`Mira ${chapterData.seriesTitle} - ${pageTitle} en ${siteConfig.name}.`}
>
  <div class="watch-container">
    <div class="header">
      <div class="breadcrumb">
        <a href={`/series/${chapterData.seriesSlug}`} class="back-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          <span>Volver a <strong>{chapterData.seriesTitle}</strong></span>
        </a>
        <h1>{pageTitle}</h1>
      </div>
    </div>

    {servers.length === 0 ? (
      <div class="no-servers">
        <p>No hay servidores disponibles para este episodio.</p>
      </div>
    ) : (
      <>
        <div class="player-wrapper" id="player-container">
          {servers[0]?.isDirectVideo ? (
             <video id="video-player" playsinline controls preload="metadata">
                <source src={defaultServerUrl} type="video/mp4" />
             </video>
          ) : (
             <iframe id="iframe-player" src={defaultServerUrl} allowfullscreen="true"></iframe>
          )}
        </div>
        
        <div class="controls-panel">
          <div class="server-options">
            <span class="servers-label">Servidores:</span>
            <div class="server-buttons" id="server-buttons">
              {servers.map((s, index) => (
                <button 
                  class:list={['server-btn', { active: index === 0 }]}
                  data-url={s.iframeUrl}
                  data-direct={s.isDirectVideo ? 'true' : 'false'}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                  {s.serverName} ({s.language})
                </button>
              ))}
            </div>
          </div>
        </div>
      </>
    )}
  </div>

  <script>
    import { actions } from 'astro:actions';
    
    // Registrar vista del episodio en segundo plano
    const currentEpisodeId = parseInt(window.location.pathname.split('/').pop() || '0');
    if (currentEpisodeId) {
      // Usamos requestIdleCallback para no bloquear el renderizado del reproductor
      const registerFn = () => {
        actions.chapters.registerView({ chapterId: currentEpisodeId }).catch(() => {});
      };
      if ('requestIdleCallback' in window) {
        requestIdleCallback(registerFn);
      } else {
        setTimeout(registerFn, 1000);
      }
    }
  </script>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      const buttons = document.querySelectorAll('.server-btn');
      const container = document.getElementById('player-container');
      if (!buttons.length || !container) return;

      buttons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          buttons.forEach(function(b) { b.classList.remove('active'); });
          btn.classList.add('active');
          
          const url = btn.getAttribute('data-url');
          const isDirect = btn.getAttribute('data-direct') === 'true';

          container.innerHTML = '';
          
          if (isDirect) {
            const video = document.createElement('video');
            video.id = 'video-player';
            video.controls = true;
            video.playsInline = true;
            video.preload = 'metadata';
            const source = document.createElement('source');
            source.src = url;
            source.type = 'video/mp4';
            video.appendChild(source);
            container.appendChild(video);
          } else {
            const iframe = document.createElement('iframe');
            iframe.id = 'iframe-player';
            iframe.src = url;
            iframe.allowFullscreen = true;
            container.appendChild(iframe);
          }
        });
      });
    });
  </script>
</Layout>

<style>
  .watch-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    box-sizing: border-box;
    color: #fff;
    min-height: 80vh;
  }
  
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .breadcrumb {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .breadcrumb h1 {
    font-size: 1.8rem;
    margin: 0;
    font-weight: 800;
  }
  
  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #aaa;
    text-decoration: none;
    font-weight: 500;
    padding: 0.5rem 1.2rem 0.5rem 0.8rem;
    border-radius: 100px;
    font-size: 0.9rem;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }
  
  .back-btn strong {
    color: #fff;
    font-weight: 700;
  }
  
  .back-btn svg {
    transition: transform 0.3s ease;
    color: #4facfe;
  }
  
  .back-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(79, 172, 254, 0.4);
    color: #fff;
    box-shadow: 0 4px 15px rgba(79, 172, 254, 0.15);
    transform: translateY(-2px);
  }
  
  .back-btn:hover svg {
    transform: translateX(-4px);
  }

  .player-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    background: #000;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .player-wrapper iframe,
  .player-wrapper video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
    border-radius: 12px;
  }

  /* Estilizar controles nativos del video */
  .player-wrapper video::-webkit-media-controls-panel {
    background: linear-gradient(transparent, rgba(0,0,0,0.8));
  }

  .controls-panel {
    margin-top: 1.5rem;
    background: #111;
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 1.5rem;
    border-radius: 12px;
  }

  .server-options {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .servers-label {
    font-weight: 700;
    color: #888;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 1px;
  }

  .server-buttons {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .server-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #222;
    color: #ccc;
    border: 1px solid #333;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }
  
  .server-btn:hover {
    background: #333;
    color: #fff;
  }

  .server-btn.active {
    background: #4facfe;
    color: #000;
    border-color: #4facfe;
    box-shadow: 0 4px 15px rgba(79, 172, 254, 0.3);
  }

  .no-servers {
    padding: 4rem;
    text-align: center;
    background: #111;
    border-radius: 12px;
    color: #888;
  }
</style>
