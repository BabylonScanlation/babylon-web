---
import { eq } from 'drizzle-orm';
import { chapters, episodeServers, series } from '../../../db/schema';
import Layout from '../../../layouts/Layout.astro';
import { getDB } from '../../../lib/db';
import { siteConfig } from '../../../site.config';

const { episodeId } = Astro.params;
if (!episodeId || isNaN(Number(episodeId))) {
  return Astro.redirect('/404');
}

const db = getDB(Astro.locals.runtime.env);

const chapterData = await db
  .select({
    id: chapters.id,
    chapterNumber: chapters.chapterNumber,
    title: chapters.title,
    seriesId: chapters.seriesId,
    seriesTitle: series.title,
    seriesSlug: series.slug,
  })
  .from(chapters)
  .innerJoin(series, eq(chapters.seriesId, series.id))
  .where(eq(chapters.id, Number(episodeId)))
  .get();

if (!chapterData) return Astro.redirect('/404');

const servers = await db
  .select()
  .from(episodeServers)
  .where(eq(episodeServers.chapterId, Number(episodeId)))
  .orderBy(episodeServers.displayOrder)
  .all();

const defaultServerUrl = servers.length > 0 && servers[0] ? servers[0].iframeUrl : '';
const pageTitle = chapterData.title || `Episodio ${chapterData.chapterNumber}`;
---

<Layout
  title={`${chapterData.seriesTitle} - ${pageTitle} - ${siteConfig.name}`}
  description={`Mira ${chapterData.seriesTitle} - ${pageTitle} en ${siteConfig.name}.`}
>
  <div class="watch-container">
    <div class="header">
      <div class="breadcrumb">
        <a href={`/series/${chapterData.seriesSlug}`} class="back-btn">← Volver a {chapterData.seriesTitle}</a>
        <h1>{pageTitle}</h1>
      </div>
    </div>

    {servers.length === 0 ? (
      <div class="no-servers">
        <p>No hay servidores disponibles para este episodio.</p>
      </div>
    ) : (
      <>
        <div class="player-wrapper">
          <iframe 
            id="video-player"
            src={defaultServerUrl} 
            allowfullscreen="true" 
          ></iframe>
        </div>
        
        <div class="controls-panel">
          <div class="server-options">
            <span class="servers-label">Servidores:</span>
            <div class="server-buttons" id="server-buttons">
              {servers.map((s, index) => (
                <button 
                  class:list={['server-btn', { active: index === 0 }]}
                  data-url={s.iframeUrl}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                  {s.serverName} ({s.language})
                </button>
              ))}
            </div>
          </div>
        </div>
      </>
    )}
  </div>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.server-btn');
    const iframe = document.getElementById('video-player');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        // Remover activo de todos
        buttons.forEach(b => b.classList.remove('active'));
        // Agregar activo al seleccionado
        btn.classList.add('active');
        // Cambiar iframe src
        if (iframe) {
          iframe.src = btn.getAttribute('data-url') || '';
        }
      });
    });
  });
</script>

<style>
  .watch-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    box-sizing: border-box;
    color: #fff;
    min-height: 80vh;
  }
  
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .breadcrumb {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .breadcrumb h1 {
    font-size: 1.8rem;
    margin: 0;
    font-weight: 800;
  }
  
  .back-btn {
    color: #4facfe;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.3s;
    font-size: 0.95rem;
  }
  .back-btn:hover {
    color: #fff;
  }

  .player-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    background: #000;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .player-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .controls-panel {
    margin-top: 1.5rem;
    background: #111;
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 1.5rem;
    border-radius: 12px;
  }

  .server-options {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .servers-label {
    font-weight: 700;
    color: #888;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 1px;
  }

  .server-buttons {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .server-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #222;
    color: #ccc;
    border: 1px solid #333;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }
  
  .server-btn:hover {
    background: #333;
    color: #fff;
  }

  .server-btn.active {
    background: #4facfe;
    color: #000;
    border-color: #4facfe;
    box-shadow: 0 4px 15px rgba(79, 172, 254, 0.3);
  }

  .no-servers {
    padding: 4rem;
    text-align: center;
    background: #111;
    border-radius: 12px;
    color: #888;
  }
</style>
