---
import Layout from '../../../layouts/Layout.astro';
import { getScanlationDetails } from '../../../lib/data/admin';
import { getDB } from '../../../lib/db';
import { siteConfig } from '../../../site.config';

const { id } = Astro.params;
const { user, runtime } = Astro.locals;

if (!user?.isAdmin) return Astro.redirect('/admin');

const db = getDB(runtime.env);
const scan = await getScanlationDetails(db, parseInt(id || '0'));

if (!scan) return Astro.redirect('/admin/scanlations');
---

<Layout title={`Gestionar ${scan.name} - ${siteConfig.shortName}`}>
  <main class="admin-container">
    <header class="page-header">
      <div class="nav-back">
        <a href="/admin/scanlations" class="back-pill">
          <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Volver a Organizaciones
        </a>
      </div>
      <div class="title-section">
        <h1>Equipo de {scan.name}</h1>
        <p class="subtitle">Añade o elimina miembros del staff de este grupo.</p>
      </div>
    </header>

    <div class="team-layout">
      {/* Columna Izquierda: Añadir Miembro y Telegram */}
      <aside class="side-panel-zone">
        {/* VINCULACIÓN TELEGRAM (NUEVO) */}
        <div class="glass-card telegram-config">
          <h3>Infraestructura Telegram</h3>
          {scan.telegramChatId ? (
            <div class="tg-status success">
              <div class="tg-icon">✅</div>
              <div class="tg-info">
                <span>Canal Vinculado</span>
                <small>ID: {scan.telegramChatId}</small>
              </div>
              <button class="btn-unlink" id="btn-clear-tg">Desvincular</button>
            </div>
          ) : (
            <div class="tg-status pending">
              <p>Este grupo no tiene un canal de Telegram propio.</p>
              <button class="btn-generate-link" id="btn-link-tg">Vincular Canal Mágicamente</button>
              <p class="hint">Al pulsar, se generará un código para el Bot.</p>
            </div>
          )}
        </div>

        <div class="glass-card mt-2">
          <h3>Añadir Nuevo Miembro</h3>
          <form id="form-add-member" class="form-vertical">
            <input type="hidden" name="scanlationId" value={scan.id} />
            <div class="form-group">
              <label>Email del Usuario</label>
              <input type="email" name="userEmail" required placeholder="ejemplo@usuario.com" />
              <p class="hint">El usuario debe estar registrado previamente en el sitio.</p>
            </div>
            <div class="form-group">
              <label>Rol en el Grupo</label>
              <select name="role">
                <option value="editor">Editor (Sube capítulos)</option>
                <option value="owner">Dueño (Gestiona el grupo)</option>
                <option value="moderator">Moderador (Limpia comentarios)</option>
              </select>
            </div>
            <button type="submit" class="btn-primary">Vincular al Equipo</button>
          </form>
        </div>
      </aside>

      {/* Columna Derecha: Lista de Miembros */}
      <section class="members-list-zone">
        <div class="glass-card">
          <h3>Personal Actual ({scan.members.length})</h3>
          <div class="members-table">
            {scan.members.map(member => (
              <div class="member-row">
                <div class="m-info">
                  <span class="m-name">{member.username || 'Sin nombre'}</span>
                  <span class="m-email">{member.email}</span>
                </div>
                <div class="m-role">
                  <span class={`role-tag ${member.role}`}>{member.role}</span>
                </div>
                <button 
                  class="btn-kick" 
                  data-uid={member.userId} 
                  data-scanid={scan.id}
                >
                  <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M18 6L6 18M6 6l12 12"></path></svg>
                </button>
              </div>
            ))}
            {scan.members.length === 0 && <p class="empty">No hay miembros vinculados aún.</p>}
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>

<script>
  import { actions } from 'astro:actions';

  // Add Member
  const form = document.getElementById('form-add-member') as HTMLFormElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const { error } = await actions.admin.addScanMember({
      scanlationId: parseInt(formData.get('scanlationId') as string),
      userEmail: formData.get('userEmail') as string,
      role: formData.get('role') as any,
    });

    if (!error) window.location.reload();
    else alert(error.message);
  });

  // Remove Member
  document.querySelectorAll('.btn-kick').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const userId = target.dataset.uid || '';
      const scanlationId = parseInt(target.dataset.scanid || '0');

      if (!confirm('¿Seguro que quieres expulsar a este miembro?')) return;

      const { error } = await actions.admin.removeScanMember({ scanlationId, userId });
      if (!error) window.location.reload();
      else alert(error.message);
    });
  });

  // Telegram Linking Logic
  const btnLink = document.getElementById('btn-link-tg');
  const scanId = parseInt(window.location.pathname.split('/').pop() || '0');

  btnLink?.addEventListener('click', async () => {
    const { data, error } = await actions.admin.generateScanLinkToken({ id: scanId });
    if (error) return alert(error.message);

    const token = data.token;
    // Creamos el enlace profundo de Telegram
    // Formato: https://t.me/TuBot?start=vincular_TOKEN
    // Pero como usamos un comando personalizado /vincular:
    const botUsername = 'TuBotBabylon'; // Sustituir por el nombre real de tu bot
    const link = `https://t.me/${botUsername}?start=vincular_${token}`;
    
    // Abrimos Telegram y pedimos al usuario que añada al bot al grupo
    window.open(link, '_blank');
    
    alert('Se ha abierto Telegram. Para completar la vinculación:\n1. Añade al Bot al grupo/canal deseado.\n2. Envía el comando /vincular ' + token + ' dentro del grupo.');
  });
  // Telegram Unlinking Logic
  const btnUnlink = document.getElementById('btn-clear-tg');
  btnUnlink?.addEventListener('click', async () => {
    if (!confirm('¿Seguro que quieres desvincular el canal de Telegram?')) return;
    const { error } = await actions.admin.unlinkScanTelegram({ id: scanId });
    if (!error) window.location.reload();
    else alert(error.message);
  });
</script>

<style>
  .admin-container { max-width: 1200px; margin: 0 auto; padding: 3rem 2rem; color: #fff; }
  .m-email { font-size: 0.8rem; color: #444; }

  /* Telegram Infrastructure Zone */
  .telegram-config { border-color: rgba(0, 191, 255, 0.2); margin-bottom: 2rem; }
  .tg-status { display: flex; flex-direction: column; gap: 1rem; }
  .tg-status.success { flex-direction: row; align-items: center; background: rgba(46, 204, 113, 0.05); padding: 1rem; border-radius: 12px; }
  .tg-icon { font-size: 1.5rem; }
  .tg-info { flex: 1; display: flex; flex-direction: column; }
  .tg-info span { font-weight: 800; color: #2ecc71; }
  .tg-info small { font-family: monospace; color: #444; }
  .btn-unlink { background: rgba(255, 255, 255, 0.05); border: none; color: #666; padding: 0.4rem 0.8rem; border-radius: 6px; cursor: pointer; font-size: 0.7rem; font-weight: 800; }
  .btn-unlink:hover { background: #ff4757; color: #fff; }

  .btn-generate-link { background: #0088cc; color: #fff; border: none; padding: 0.8rem; border-radius: 10px; font-weight: 800; cursor: pointer; transition: all 0.3s; }
  .btn-generate-link:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(0, 136, 204, 0.4); }

  .mt-2 { margin-top: 2rem; }
  .role-tag { font-size: 0.6rem; font-weight: 900; padding: 0.2rem 0.6rem; border-radius: 4px; text-transform: uppercase; }

  @media (max-width: 900px) { .team-layout { grid-template-columns: 1fr; } }
</style>
