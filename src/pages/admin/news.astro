---
import { env } from 'cloudflare:workers';
import { asc, desc, inArray, or, sql } from 'drizzle-orm';
import AdminNewsManager from '../../components/AdminNewsManager.svelte';
import { chapters, news, series } from '../../db/schema';
import Layout from '../../layouts/Layout.astro';
import { getDB } from '../../lib/db';
import { siteConfig } from '../../site.config';

// Orion: Configuración de paginación
const limit = 18;
const offsetParam = Astro.url.searchParams.get('offset');
const offset = offsetParam ? parseInt(offsetParam, 10) : 0;

const db = getDB(env);
const user = Astro.locals.user;

// Orion: Lógica de filtrado multi-tenant
const userScanIds = user?.isAdmin ? [] : user?.scanlations?.map((s) => s.id) || [];

// Filtro para mostrar series donde el scanlation participa
const seriesFilter = user?.isAdmin
  ? undefined
  : sql`EXISTS (SELECT 1 FROM ${chapters} WHERE ${chapters.seriesId} = ${series.id} AND ${chapters.scanlationId} IN (${sql.raw(userScanIds.join(',') || '0')}))`;

// 1. Obtener total para paginación con filtro
const totalResult = await db
  .select({ count: sql<number>`count(*)` })
  .from(series)
  .where(seriesFilter)
  .get();
const totalSeriesCount = totalResult?.count || 0;

// 2. Obtener series paginadas y filtradas
const allSeries = await db
  .select({
    id: series.id,
    title: series.title,
    coverImageUrl: series.coverImageUrl,
    isNsfw: series.isNsfw,
  })
  .from(series)
  .where(seriesFilter)
  .orderBy(asc(series.isNsfw), asc(series.title))
  .limit(limit)
  .offset(offset)
  .all();

// 3. Obtener noticias vinculadas a las series permitidas o globales del scanlation
const newsFilter = user?.isAdmin
  ? undefined
  : or(
      inArray(
        news.seriesId,
        allSeries.map((s) => s.id).length > 0 ? allSeries.map((s) => s.id) : [-1]
      ),
      inArray(news.scanlationId, userScanIds)
    );

const allNews = await db
  .select()
  .from(news)
  .where(newsFilter)
  .orderBy(desc(sql`CAST(${news.createdAt} AS INTEGER)`))
  .all();

// Orion: En local, usamos siempre la ruta relativa para que funcione en PC y móviles
let r2PublicUrlAssets = env.R2_PUBLIC_URL_ASSETS;
const isLocal = Astro.url.hostname === 'localhost' || Astro.url.hostname === '127.0.0.1';

if (isLocal || !r2PublicUrlAssets) {
  r2PublicUrlAssets = '/api/assets/proxy';
}
---

<Layout title={`Gestión de Noticias - ${siteConfig.shortName}`}>
  <main class="admin-page-container">
    <div class="glass-header">
      <div class="header-content">
        <a href="/admin" class="back-pill">
          <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Panel Admin
        </a>
        <div class="title-section">
          <h1>Gestor de Novedades</h1>
          <p class="subtitle">Selecciona una obra para administrar sus noticias y comunica actualizaciones a tus lectores.</p>
        </div>
      </div>
    </div>
    
    <div class="content-grid">
      <div class="news-zone">
        <!-- Componente Svelte Unificado -->
        <AdminNewsManager 
          client:load 
          allSeries={allSeries} 
          initialNews={allNews} 
          currentUser={user} 
          r2PublicUrlAssets={r2PublicUrlAssets}
        />
      </div>
    </div>

    <!-- Controles de Paginación (Solo si no hay una serie seleccionada) -->
    <div 
      class="pagination-outer-wrapper" 
      id="pagination-controls"
      data-offset={offset}
      data-limit={limit}
    >
      <nav class="pagination-wrapper">
        <div class="pagination-info">
          Mostrando <span class="highlight">{allSeries.length}</span> de <span class="highlight">{totalSeriesCount}</span> series
        </div>
        <div class="pagination-controls">
          <button 
            id="prev-page" 
            class:list={['pag-btn', 'prev', { disabled: offset === 0 }]}
            disabled={offset === 0}
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="3"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          
          <div class="page-numbers">
            <span class="current-page">{Math.floor(offset / limit) + 1}</span>
            <span class="separator">/</span>
            <span class="total-pages">{Math.ceil(totalSeriesCount / limit)}</span>
          </div>

          <button 
            id="next-page" 
            class:list={['pag-btn', 'next', { disabled: offset + limit >= totalSeriesCount }]}
            disabled={offset + limit >= totalSeriesCount}
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="3"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      </nav>
    </div>
  </main>

  <script>
    const paginationFooter = document.getElementById('pagination-controls');
    const offset = parseInt(paginationFooter?.dataset.offset || '0');
    const limit = parseInt(paginationFooter?.dataset.limit || '18');

    const prevBtn = document.getElementById('prev-page');
    const nextBtn = document.getElementById('next-page');

    window.addEventListener('series-selected', (e: any) => {
      if (paginationFooter) {
        paginationFooter.style.display = e.detail.selected ? 'none' : 'flex';
      }
    });

    prevBtn?.addEventListener('click', () => {
      const newOffset = Math.max(0, offset - limit);
      window.location.href = `/admin/news?offset=${newOffset}`;
    });

    nextBtn?.addEventListener('click', () => {
      const newOffset = offset + limit;
      window.location.href = `/admin/news?offset=${newOffset}`;
    });
  </script>

  <style is:global>
    /* Estilos unificados para la paginación (Estilo Search) */
    .pagination-outer-wrapper { margin-top: 2rem; margin-bottom: 0; display: flex; justify-content: center; width: 100%; }

    .pagination-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
    }

    .pagination-info {
      color: #666;
      font-size: 0.9rem;
      font-weight: 500;
    }

    .pagination-info .highlight {
      color: #aaa;
      font-weight: 700;
    }

    .pagination-controls {
      display: flex;
      align-items: center;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(10px);
      padding: 0.5rem;
      border-radius: 100px;
      gap: 0.5rem;
    }

    .pag-btn {
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.05);
      color: #fff;
      border-radius: 50%;
      border: none;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .pag-btn:hover:not(.disabled) {
      background: var(--accent-color, #00bfff);
      color: #000;
      transform: scale(1.1);
    }

    .pag-btn.disabled {
      opacity: 0.2;
      cursor: not-allowed;
      pointer-events: none;
    }

    .page-numbers {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0 1.5rem;
      font-weight: 800;
    }

    .current-page {
      color: var(--accent-color, #00bfff);
      font-size: 1.2rem;
    }

    .separator {
      color: #333;
      font-size: 0.8rem;
    }

    .total-pages {
      color: #666;
      font-size: 1rem;
    }
  </style>

<style>
  .admin-page-container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    min-height: auto;
  }

  .glass-header {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    padding: 1rem 1.5rem;
    margin-bottom: 0.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .header-content {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }

  .title-section {
    flex: 1 1 400px;
  }

  .back-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.2rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 100px;
    color: #888;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.3s ease;
  }

  .back-pill:hover {
    background: rgba(0, 191, 255, 0.1);
    border-color: var(--accent-color);
    color: #fff;
    transform: translateX(-5px);
  }

  .title-section h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
    background: linear-gradient(135deg, #fff 0%, #aaa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.02em;
  }

  .subtitle {
    color: #666;
    font-size: 1.1rem;
    margin: 0;
    line-height: 1.5;
  }

  .content-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .news-zone {
    animation: slideUp 0.6s ease-out;
  }

  @keyframes slideUp {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  @media (max-width: 768px) {
    .glass-header {
      padding: 2rem 1.5rem;
      border-radius: 20px;
    }
    
    .title-section h1 {
      font-size: 2rem;
    }
  }
</style>
