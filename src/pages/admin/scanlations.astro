---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { getAllScanlations } from '../../lib/data/admin';
import { getDB } from '../../lib/db';
import { siteConfig } from '../../site.config';

const { user } = Astro.locals;
if (!user?.isAdmin) return Astro.redirect('/admin');

const db = getDB(env);
const scanlations = await getAllScanlations(db);
---

<Layout title={`Gestión de Scanlations - ${siteConfig.shortName}`}>
  <div class="padded-content">
    <main class="admin-page-container">
      <div class="glass-header">
        <div class="header-content">
          <a href="/admin" class="back-pill">
            <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            Panel Admin
          </a>
          <div class="header-flex">
            <div class="title-section">
              <h1>Centro de Scanlations</h1>
              <p class="subtitle">Gestiona las organizaciones externas que publican en tu plataforma.</p>
            </div>
            <div class="header-actions">
              <button class="btn-create-scan" onclick="document.getElementById('creation-zone').classList.remove('hidden')">
                <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2.5" fill="none"><path d="M12 5v14M5 12h14"></path></svg>
                Registrar Nuevo Scanlation
              </button>
            </div>
          </div>
        </div>
      </div>

      {/* Formulario Inline (Astra: Mejor que un modal) */}
      <section id="creation-zone" class="creation-zone hidden">
        <div class="glass-card-form">
          <div class="form-header">
            <h3>Registrar Nueva Organización</h3>
            <button class="btn-close-form" onclick="document.getElementById('creation-zone').classList.add('hidden')">
              <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2.5" fill="none"><path d="M18 6L6 18M6 6l12 12"></path></svg>
            </button>
          </div>
          <form id="form-create-scan" class="inline-form">
            <div class="form-grid">
              <div class="form-group">
                <label>Nombre del Grupo</label>
                <input type="text" name="name" required placeholder="Ej: My Scanlation" class="glass-input" />
              </div>
              <div class="form-group">
                <label>Slug (URL)</label>
                <input type="text" name="slug" required placeholder="my-scanlation" class="glass-input" />
              </div>
              <div class="form-group full-width">
                <label>Descripción del Scanlation</label>
                <textarea name="description" placeholder="Cuéntanos un poco sobre este grupo..." class="glass-input"></textarea>
              </div>
            </div>
            <div class="form-footer">
              <button type="submit" class="btn-submit-premium">
                Finalizar Registro y Activar
              </button>
            </div>
          </form>
        </div>
      </section>

      <div class="scanlations-grid">
        {scanlations.length > 0 ? (
          scanlations.map(scan => (
            <div class={`scan-card ${!scan.isActive ? 'is-disabled' : ''}`}>
              <div class="scan-info">
                <div class="scan-header">
                  <span class="scan-id">#{scan.id}</span>
                  <span class={`status-badge ${scan.isActive ? 'active' : 'inactive'}`}>
                    {scan.isActive ? 'ACTIVO' : 'DESACTIVADO'}
                  </span>
                </div>
                <h2>{scan.name}</h2>
                <p class="slug">/{scan.slug}</p>
                
                <div class="stats-row">
                  <div class="stat">
                    <span class="val">{scan.seriesCount}</span>
                    <span class="lab">Series</span>
                  </div>
                  <div class="stat">
                    <span class="val">{scan.memberCount}</span>
                    <span class="lab">Miembros</span>
                  </div>
                </div>
              </div>
              
              <div class="scan-actions">
                <button class="btn-manage" onclick={`window.location.href='/admin/scanlations/${scan.id}'`}>
                  Gestionar Equipo
                </button>
                <button 
                  class="btn-toggle" 
                  data-id={scan.id} 
                  data-active={scan.isActive?.toString()}
                >
                  {scan.isActive ? 'Bannear/Desactivar' : 'Reactivar'}
                </button>
              </div>
            </div>
          ))
        ) : (
          <div class="empty-state">
            <div class="empty-icon">🤝</div>
            <h3>Paz total</h3>
            <p>No hay organizaciones registradas en la plataforma todavía.</p>
          </div>
        )}
      </div>
    </main>
  </div>
</Layout>

<script>
  import { actions } from 'astro:actions';

  // Toggle Status
  document.querySelectorAll('.btn-toggle').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const id = parseInt(target.dataset.id || '0');
      const currentActive = target.dataset.active === 'true';
      
      if (!confirm(`¿Estás seguro de ${currentActive ? 'desactivar' : 'activar'} este scanlation?`)) return;
      
      const { error } = await actions.admin.toggleScanlationStatus({ id, isActive: !currentActive });
      if (!error) window.location.reload();
      else alert(error.message);
    });
  });

  // Create Scanlation
  const form = document.getElementById('form-create-scan') as HTMLFormElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const data = {
      name: formData.get('name') as string,
      slug: formData.get('slug') as string,
      description: formData.get('description') as string,
    };

    const { error } = await actions.admin.createScanlation(data);
    if (!error) window.location.reload();
    else alert(error.message);
  });
</script>

<style>
  .admin-page-container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    min-height: calc(100vh - 120px);
    display: flex;
    flex-direction: column;
  }

  .glass-header {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    padding: 1rem 1.5rem;
    margin-bottom: 0.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .header-content {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }

  .header-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    flex: 1 1 500px;
  }

  .title-section {
    flex: 1;
  }

  .back-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.2rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 100px;
    color: #888;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.3s ease;
    align-self: flex-start;
  }

  .back-pill:hover {
    background: rgba(0, 191, 255, 0.1);
    border-color: var(--accent-color);
    color: #fff;
    transform: translateX(-5px);
  }

  .title-section h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
    background: linear-gradient(135deg, #fff 0%, #aaa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.02em;
  }

  .subtitle {
    color: #666;
    font-size: 1.1rem;
    margin: 0;
    max-width: 600px;
    line-height: 1.5;
  }

  .header-actions {
    display: flex;
    align-items: center;
  }

  /* Creation Zone Inline (Astra) */
  .creation-zone {
    margin-bottom: 3rem;
    animation: slideDown 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  .creation-zone.hidden {
    display: none;
  }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .glass-card-form {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 2rem;
    backdrop-filter: blur(10px);
  }

  .form-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .form-header h3 { margin: 0; font-size: 1.4rem; color: #00bfff; font-weight: 800; }

  .btn-close-form {
    background: rgba(255, 255, 255, 0.05);
    border: none;
    color: #666;
    padding: 0.5rem;
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.3s;
  }

  .btn-close-form:hover { background: #ff4757; color: #fff; }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .form-group.full-width { grid-column: 1 / -1; }

  .glass-input {
    background: #000;
    border: 1px solid #222;
    padding: 1rem;
    border-radius: 12px;
    color: #fff;
    width: 100%;
    font-family: inherit;
    transition: border-color 0.3s;
  }

  .glass-input:focus { border-color: #00bfff; outline: none; }

  .btn-submit-premium {
    background: linear-gradient(135deg, #00bfff 0%, #0077ff 100%);
    color: #000;
    border: none;
    padding: 1rem 2rem;
    border-radius: 12px;
    font-weight: 900;
    cursor: pointer;
    margin-top: 1.5rem;
    width: 100%;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: transform 0.3s;
  }

  .btn-submit-premium:hover { transform: scale(1.02); }

  /* Grid */
  .scanlations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 2rem;
    flex: 1;
  }

  .scanlations-grid:has(.empty-state) {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .scan-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.3s;
  }

  .scan-card:hover { background: rgba(255, 255, 255, 0.05); border-color: #00bfff44; }
  .scan-card.is-disabled { opacity: 0.5; filter: grayscale(1); border-color: #ff4757; }

  .scan-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
  .scan-id { font-family: monospace; color: #444; font-weight: 700; }
  .status-badge { font-size: 0.65rem; font-weight: 900; padding: 0.3rem 0.6rem; border-radius: 6px; }
  .status-badge.active { background: rgba(46, 204, 113, 0.1); color: #2ecc71; }
  .status-badge.inactive { background: rgba(231, 76, 60, 0.1); color: #e74c3c; }

  .scan-card h2 { margin: 0; font-size: 1.5rem; }
  .slug { color: #00bfff; font-family: monospace; margin: 0.2rem 0 1.5rem 0; font-size: 0.9rem; }

  .stats-row { display: flex; gap: 2rem; margin-bottom: 2rem; }
  .stat { display: flex; flex-direction: column; }
  .stat .val { font-size: 1.5rem; font-weight: 900; }
  .stat .lab { font-size: 0.7rem; color: #555; text-transform: uppercase; font-weight: 800; }

  .scan-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .btn-manage { background: #fff; color: #000; border: none; padding: 0.8rem; border-radius: 10px; font-weight: 700; cursor: pointer; }
  .btn-toggle { background: rgba(255, 255, 255, 0.05); color: #fff; border: 1px solid rgba(255, 255, 255, 0.1); padding: 0.8rem; border-radius: 10px; font-weight: 700; cursor: pointer; }
  .btn-toggle:hover { background: #ff4757; border-color: #ff4757; }

  @media (max-width: 768px) {
    .header-flex {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
    .glass-header {
      padding: 2rem 1.5rem;
      border-radius: 20px;
    }
    .title-section h1 {
      font-size: 2rem;
    }
    .btn-create-scan {
      width: 100%;
      justify-content: center;
    }
  }

  /* Empty State (Astra: Centrado Absoluto) */
  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 0 2rem;
    color: #444;
    margin: auto 0;
  }
  .empty-icon { font-size: 4rem; margin-bottom: 1.5rem; opacity: 0.2; }
  .empty-state h3 { color: #666; margin-bottom: 0.5rem; font-size: 1.5rem; font-weight: 800; }
</style>
