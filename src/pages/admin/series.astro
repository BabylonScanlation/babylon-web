---
import { env } from 'cloudflare:workers';
import AdminSeriesManager from '../../components/AdminSeriesManager.astro';
import AdminThumbnailCropperModalSvelte from '../../components/AdminThumbnailCropperModal.svelte';
import Layout from '../../layouts/Layout.astro';
import { getAdminSeriesWithChapters } from '../../lib/data/admin';
import { getDB } from '../../lib/db';
import { logError } from '../../lib/logError';

const { user } = Astro.locals;
const r2PublicUrlAssets = env.R2_PUBLIC_URL_ASSETS;

const limit = 12;
const offsetParam = Astro.url.searchParams.get('offset');
const offset = offsetParam ? parseInt(offsetParam, 10) : 0;
const searchQuery = Astro.url.searchParams.get('q') || '';

let allSeries: any[] = [];
let totalSeries = 0;
const success = Astro.url.searchParams.get('success');
let error = Astro.url.searchParams.get('error');

// Orion: Lógica Multi-tenant para el filtrado de series
const userScanId = !user?.isAdmin ? user?.scanlations?.[0]?.id : undefined;

try {
  const db = getDB(env);
  const data = await getAdminSeriesWithChapters(db, limit, offset, searchQuery, userScanId);
  allSeries = data.series;
  totalSeries = data.total;
} catch (e) {
  const errorForLog = e;
  logError(errorForLog, 'Error al cargar las series para el panel de administración (Direct DB)');
  error = 'No se pudo conectar con la base de datos para cargar las series.';
}
---

<Layout title="Gestionar Series">

  <main class="admin-page-container">
    <div class="glass-header">
      <div class="header-content">
        <a href="/admin" class="back-pill">
          <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Panel Admin
        </a>
        <div class="header-flex">
          <div class="title-section">
            <h1>Biblioteca de Series</h1>
            <p class="subtitle">Gestiona el catálogo, edita metadatos y administra capítulos.</p>
          </div>

          <div class="search-wrapper">
            <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input
              type="text"
              id="series-search"
              placeholder="Buscar serie..."
              class="search-input"
              value={searchQuery}
            />
          </div>
        </div>
      </div>
    </div>

    {success && <div class="alert success">{success}</div>}
    {error && <div class="alert error">{error}</div>}

    <div id="series-list" class="series-grid">
    {
      allSeries.length > 0 ? (
        allSeries.map((series) => (
          <div class="series-item-wrapper">
            <AdminSeriesManager series={series} r2PublicUrlAssets={r2PublicUrlAssets} />
          </div>
        ))
      ) : (
        <div class="empty-state">
          <div class="empty-icon">📚</div>
          <h3>¡Empieza tu aventura!</h3>
          <p>
            Aún no has subido ninguna serie. Por favor, sube una serie desde el panel
            <a href="/admin/upload" class="accent-link">control de contenido</a>.
          </p>
        </div>
      )
    }
    </div>

    <!-- Controles de Paginación -->
    <div class="pagination-controls">
      <button id="prev-page" class="pagination-btn" disabled>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Anterior
      </button>
      <span class="page-indicator">Página <span id="current-page-display">1</span></span>
      <button 
        id="next-page" 
        class="pagination-btn" 
        disabled={allSeries.length < 12}
        data-total={totalSeries}
      >
        Siguiente
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </main>

  <AdminThumbnailCropperModalSvelte client:idle />

  <script>
    // Limpieza de URL Selectiva (Preservar offset para paginación)
    if (window.location.search) {
      const url = new URL(window.location.href);
      const params = url.searchParams;
      let changed = false;

      if (params.has('success') || params.has('error')) {
        params.delete('success');
        params.delete('error');
        changed = true;
      }

      if (changed) {
        window.history.replaceState({}, document.title, url.pathname + url.search);
      }
    }

    const searchInput = document.getElementById('series-search') as HTMLInputElement;
    const seriesList = document.getElementById('series-list');
    const detailsElements = document.querySelectorAll('details.series-card') as NodeListOf<HTMLDetailsElement>;

    // 1. Buscador con redirección (Server Side)
    if (searchInput) {
      searchInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
          const searchTerm = searchInput.value.trim();
          const url = new URL(window.location.href);
          if (searchTerm) {
            url.searchParams.set('q', searchTerm);
          } else {
            url.searchParams.delete('q');
          }
          url.searchParams.set('offset', '0'); // Reiniciar a primera página
          window.location.href = url.toString();
        }
      });
    }

    // 2. Lógica de Acordeón con Expansión de Fila Optimizada
    detailsElements.forEach((detail) => {
      detail.addEventListener('toggle', (event) => {
        const target = event.target as HTMLDetailsElement;
        if (!target.open) {
          target.closest('.series-item-wrapper')?.classList.remove('is-expanded');
          return;
        }

        // Si estamos abriendo, optimizamos el proceso
        requestAnimationFrame(() => {
          const wrapper = target.closest('.series-item-wrapper');

          if (seriesList) {
            // A) Cerrar otros de forma eficiente
            detailsElements.forEach((otherDetail) => {
              if (otherDetail !== target && otherDetail.open) {
                otherDetail.removeAttribute('open');
                otherDetail.closest('.series-item-wrapper')?.classList.remove('is-expanded');
              }
            });

            // B) Activar expansión
            wrapper?.classList.add('is-expanded');

            // C) Scroll suave desacoplado del reflow inicial
            setTimeout(() => {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 50);
          }
        });
      });
    });
    // 3. Lógica de Paginación
    const prevBtn = document.getElementById('prev-page') as HTMLButtonElement;
    const nextBtn = document.getElementById('next-page') as HTMLButtonElement;
    const pageDisplay = document.getElementById('current-page-display');

    const urlParams = new URLSearchParams(window.location.search);
    const limit = 12; 
    const currentOffset = parseInt(urlParams.get('offset') || '0');
    const total = parseInt(nextBtn?.dataset.total || '0');
    const currentPage = Math.floor(currentOffset / limit) + 1;

    if (pageDisplay) pageDisplay.textContent = currentPage.toString();
    if (prevBtn) prevBtn.disabled = currentOffset === 0;
    if (nextBtn) nextBtn.disabled = (currentOffset + limit) >= total;

    prevBtn?.addEventListener('click', () => {
      const newOffset = Math.max(0, currentOffset - limit);
      const url = new URL(window.location.href);
      url.searchParams.set('offset', newOffset.toString());
      window.location.href = url.toString();
    });

    nextBtn?.addEventListener('click', () => {
      const newOffset = currentOffset + limit;
      const url = new URL(window.location.href);
      url.searchParams.set('offset', newOffset.toString());
      window.location.href = url.toString();
    });
  </script>

  <style>
    .pagination-controls {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 2rem;
      margin-top: 0rem;
      padding: 2rem 2rem 0 2rem; /* Astra: Eliminado espaciado inferior */
      border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .pagination-btn {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.8rem 1.5rem;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 12px;
      color: #fff;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
    }

    .pagination-btn:hover:not(:disabled) {
      background: rgba(79, 172, 254, 0.1);
      border-color: #4facfe;
      color: #4facfe;
      transform: translateY(-2px);
    }

    .pagination-btn:disabled {
      opacity: 0.3;
      cursor: not-allowed;
    }

    .page-indicator {
      color: #666;
      font-weight: 600;
      font-size: 0.9rem;
    }

    #current-page-display {
      color: #fff;
    }

    .admin-page-container {
      width: 100%;
      max-width: 1400px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
      min-height: calc(100vh - 120px);
      display: flex;
      flex-direction: column;
    }

    .glass-header {
      background: rgba(255, 255, 255, 0.03);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 24px;
      padding: 1rem 1.5rem;
      margin-bottom: 0.5rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
      flex-shrink: 0;
    }

    .header-content {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem 2rem;
    }

    .header-flex {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 2rem;
      flex: 1 1 500px;
    }

    .title-section {
      flex: 1;
    }

    .back-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.6rem 1.2rem;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 100px;
      color: #888;
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      transition: all 0.3s ease;
    }

    .back-pill:hover {
      background: rgba(0, 191, 255, 0.1);
      border-color: var(--accent-color);
      color: #fff;
      transform: translateX(-5px);
    }

    .title-section h1 {
      font-size: 2.5rem;
      font-weight: 800;
      margin: 0 0 0.5rem 0;
      background: linear-gradient(135deg, #fff 0%, #aaa 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      letter-spacing: -0.02em;
    }

    .subtitle {
      color: #666;
      font-size: 1.1rem;
      margin: 0;
      line-height: 1.5;
    }

    /* Search */
    .search-wrapper {
      position: relative;
      width: 100%;
      max-width: 400px;
    }

    .search-icon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: #666;
      pointer-events: none;
    }

    .search-input {
      width: 100%;
      padding: 0.8rem 1rem 0.8rem 2.8rem;
      background-color: #1a1a1a;
      border: 1px solid #333;
      color: #fff;
      border-radius: 12px;
      font-size: 1rem;
      transition: all 0.2s;
    }

    .search-input:focus {
      outline: none;
      border-color: #4facfe;
      background-color: #222;
      box-shadow: 0 0 0 4px rgba(79, 172, 254, 0.1);
    }

    /* Grid Layout */
    .series-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.5rem;
      align-items: start;
      transition: all 0.3s ease;
      flex: 1;
    }

    /* Centrado vertical si está vacío (solo cuando el grid en sí no tiene series,
       no cuando una tarjeta anidada muestra su propio empty-state de capítulos) */
    .series-grid:has(> .empty-state) {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .series-item-wrapper {
      width: 100%;
      content-visibility: auto;
      contain-intrinsic-size: 1px 220px;
    }

    .series-item-wrapper.is-expanded {
      grid-column: 1 / -1;
      z-index: 20;
      content-visibility: visible;
    }

    @media (max-width: 768px) {
      .admin-page-container {
        min-height: calc(100vh - 80px);
      }
      .header-flex {
        flex-direction: column;
        align-items: flex-start;
        gap: 1.5rem;
      }
      .search-wrapper {
        max-width: 100%;
      }
      .glass-header {
        padding: 2rem 1.5rem;
        border-radius: 20px;
      }
      .title-section h1 {
        font-size: 2rem;
      }
    }

    @media (max-width: 768px) {
      .series-grid {
        grid-template-columns: 1fr;
      }
    }

    /* Alerts */
    .alert {
      padding: 1rem;
      border-radius: 8px;
      margin-bottom: 2rem;
      font-weight: 500;
    }
    .alert.success { background: rgba(46, 204, 113, 0.15); color: #2ecc71; border: 1px solid rgba(46, 204, 113, 0.3); }
    .alert.error { background: rgba(231, 76, 60, 0.15); color: #e74c3c; border: 1px solid rgba(231, 76, 60, 0.3); }

    /* Empty State (Astra: Centrado Absoluto) */
    .empty-state {
      text-align: center;
      padding: 0 2rem;
      color: #444;
    }
    .empty-icon { font-size: 4rem; margin-bottom: 1.5rem; opacity: 0.2; }
    .empty-state h3 { color: #666; margin-bottom: 0.5rem; font-size: 1.5rem; font-weight: 800; }
    .accent-link {
      color: #00d2ff;
      text-decoration: none;
      font-weight: 700;
      transition: opacity 0.2s;
    }
    .accent-link:hover {
      opacity: 0.8;
      text-decoration: underline;
    }
  </style>
</Layout>
