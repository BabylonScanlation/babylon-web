---
import { env } from 'cloudflare:workers';
import '../styles/global.css';
import AdblockWall from '../components/AdblockWall.astro';
import BottomNav from '../components/BottomNav.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getNewsCount } from '../lib/data/news';
import { getDB } from '../lib/db';
import { siteConfig } from '../site.config';

// Orion: Obtención de contador en el servidor con caché en KV (Ahorro masivo de D1)

const db = getDB(env);
const kv = env.KV_VIEWS;

let serverNewsCount = 0;
if (!Astro.url.pathname.startsWith('/admin')) {
  const cacheKey = 'news_count_cache';
  const cachedCount = kv ? await kv.get(cacheKey) : null;

  if (cachedCount) {
    serverNewsCount = parseInt(cachedCount, 10);
  } else {
    serverNewsCount = await getNewsCount(db);
    // Cache por 5 minutos para reducir carga en D1
    if (kv) {
      await kv.put(cacheKey, serverNewsCount.toString(), {
        expirationTtl: 300,
      });
    }
  }
}

const {
  title: pageTitle,
  description = siteConfig.description,
  ogImage = siteConfig.assets.ogImage,
  canonicalURL = Astro.url.href,
  isNsfwContent, // Orion: Prop para forzar la temática según el contenido actual
} = Astro.props;

const { user } = Astro.locals;

// Orion: Detección de dispositivo para evitar carga de componentes móviles en Desktop
const ua = Astro.request.headers.get('user-agent') || '';
const isMobile = /mobile|iphone|ipad|android|blackberry|opera mini|iemobile|wpdesktop/i.test(ua);

const title = pageTitle ? `${pageTitle} | ${siteConfig.shortName}` : siteConfig.name;

const isAdminPage = Astro.url.pathname.startsWith('/admin');
const isVerifyPage = Astro.url.pathname === '/verify';

const isVerified = Astro.cookies.get('site_verified')?.value === 'true';
const isBot = (Astro.locals as any).isBot;
const shouldBlockContent = !isVerified && !isVerifyPage && !isAdminPage && !isBot;

// Astra: Detección de modo NSFW.
// Prioridad: 1. Prop de la página (para forzar color en series específicas) -> 2. Cookie Global
const isNsfw =
  isNsfwContent !== undefined ? isNsfwContent : Astro.cookies.get('babylon_nsfw')?.value === 'true';

// Orion: Detección de SmartLinks (Prioridad .env para Astro Dev)
const slAdult = env?.ADSTERRA_SMARTLINK_ADULT || import.meta.env.ADSTERRA_SMARTLINK_ADULT || '';
const slMain =
  env?.ADSTERRA_SMARTLINK_MAINSTREAM || import.meta.env.ADSTERRA_SMARTLINK_MAINSTREAM || '';
const slExtra = env?.ADSTERRA_SMARTLINK_EXTRA || import.meta.env.ADSTERRA_SMARTLINK_EXTRA || '';
const slMonetag =
  env?.PUBLIC_MONETAG_SMARTLINK_URL || import.meta.env.PUBLIC_MONETAG_SMARTLINK_URL || '';
const slMonetag2 =
  env?.PUBLIC_MONETAG_SMARTLINK_2_URL || import.meta.env.PUBLIC_MONETAG_SMARTLINK_2_URL || '';
const slMonetag3 =
  env?.PUBLIC_MONETAG_SMARTLINK_3_URL || import.meta.env.PUBLIC_MONETAG_SMARTLINK_3_URL || '';

// Orion: URL Base para metadatos absolutos
const siteUrl = siteConfig.url;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---

<!doctype html>
<html
  lang="es"
  class:list={[{ 'age-gate-active': shouldBlockContent, 'nsfw-mode': isNsfw }]}
>
  <head>
    <script is:inline>
      /**
       * Astra Orion: State-Only Precision Shield
       * Protege botones, texto e imágenes de anuncios pero permite navegación limpia.
       */
      (function () {
        window.__AD_SILENCED = false;
        let adSilenceTimer = null;
        const PROTECTED =
          'a, button, input, textarea, select, [role="button"], [onclick], .nav-item, .nav-btn, .hud-nav-btn, .nav-zone-btn, .nav-chapter-btn, .swiper-button-next, .swiper-button-prev, .premium-nav, .pill-group, .tool-btn, .back-pill, p, span, h1, h2, h3, h4, h5, h6, li, label, strong, em, b, i, img, canvas, svg, .page-frame, .comments-wrapper, .site-header, .site-footer, .modal-body, .reader-cfg-panel';

        const silenceAds = (e) => {
          if (e.target && e.target.closest(PROTECTED)) {
            window.__AD_SILENCED = true;
            if (adSilenceTimer) clearTimeout(adSilenceTimer);
            adSilenceTimer = setTimeout(() => {
              window.__AD_SILENCED = false;
            }, 400);
          }
        };

        document.addEventListener('mousedown', silenceAds, {
          capture: true,
          passive: true,
        });
        document.addEventListener('touchstart', silenceAds, {
          capture: true,
          passive: true,
        });
        document.addEventListener('click', silenceAds, {
          capture: true,
          passive: true,
        });

        // Blindaje de APIs críticas
        const originalOpen = window.open;
        Object.defineProperty(window, 'open', {
          configurable: false,
          writable: false,
          value: function (...args) {
            if (window.__AD_SILENCED) {
              console.warn(
                '[SmartShield] Popup bloqueado por interacción con UI'
              );
              return null;
            }
            return originalOpen.apply(this, args);
          },
        });

        const originalClick = HTMLAnchorElement.prototype.click;
        HTMLAnchorElement.prototype.click = function (...args) {
          if (window.__AD_SILENCED) {
            console.warn('[SmartShield] Click programático bloqueado');
            return;
          }
          return originalClick.apply(this, args);
        };

        // 4. Caza específica del overlay transparente clickjacker de Multitags
        const observer = new MutationObserver((mutations) => {
          for (const m of mutations) {
            m.addedNodes.forEach((node) => {
              if (node.nodeType !== 1) return;
              const s = window.getComputedStyle(node);

              // Buscamos un elemento que cubra toda la pantalla, con alto z-index
              if (
                parseInt(s.zIndex) > 5000 &&
                (s.position === 'fixed' || s.position === 'absolute')
              ) {
                const r = node.getBoundingClientRect();
                if (
                  r.width >= window.innerWidth * 0.95 &&
                  r.height >= window.innerHeight * 0.95
                ) {
                  // Si es casi invisible (típico del clickjacker de monetag)
                  const isTransparent =
                    parseFloat(s.opacity) < 0.1 ||
                    s.backgroundColor === 'rgba(0, 0, 0, 0)' ||
                    s.backgroundColor === 'transparent';

                  if (
                    isTransparent &&
                    !node.closest(
                      '#global-utilities-root, .site-header, .modal-body, .comments-wrapper, .ad-container-root'
                    )
                  ) {
                    node.style.pointerEvents = 'none';
                    node.style.zIndex = '-1';
                    console.warn(
                      '[SmartShield] Overlay transparente (Clickjacker) neutralizado'
                    );
                  }
                }
              }
            });
          }
        });
        observer.observe(document.documentElement, {
          childList: true,
          subtree: true,
        });
      })();
    </script>
    <style is:inline>
      /* Z-Index quirúrgico: UI por encima para evitar overlays */
      .site-header,
      .modal-body,
      .hud-nav-btn,
      .nav-zone-btn,
      .nav-chapter-btn,
      #global-utilities-root,
      .comments-wrapper {
        z-index: 2147483647 !important;
      }
      .reader-container {
        position: relative;
        z-index: 1000;
      }
    </style>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    {
      import.meta.env.PROD && (
        <>
          <link rel="icon" type="image/png" href={siteConfig.assets.favicon} />
          <link rel="manifest" href="/manifest.json?v=2" />
        </>
      )
    }
    <meta name="theme-color" content={siteConfig.theme.accent} />
    <meta
      name="google-site-verification"
      content="p13-r-hLZ82o8n9SUSdk_-bOPDu6aqYAvk8jf8ihFvw"
    />

    <!-- Primary Meta Tags -->
    <title>{title}</title>

    {/* Astra: staff-protection-shield - Oculta anuncios proactivamente para el staff */}
    {(Astro.locals.isStaff || user?.isAdmin) && (
      <style is:inline>
        .ad-container-root, 
        .reader-top-ad, 
        .reader-bottom-ad, 
        .series-bottom-ad-wrapper,
        .ad-inner-wrapper,
        [id*="container-ad-inst"],
        [id*="slot-ad-inst"],
        [class*="ad-placeholder"] { 
          display: none !important; 
          visibility: hidden !important;
          opacity: 0 !important;
          pointer-events: none !important;
          height: 0 !important;
          margin: 0 !important;
          padding: 0 !important;
        }
      </style>
      <script is:inline>
        // Orion: Nuclear AdBlock for Staff (Client-side)
        (function() {
          const killAds = () => {
            const targets = document.querySelectorAll('.ad-container-root, .reader-top-ad, .reader-bottom-ad, [id*="ad-inst"], [id*="slot-ad-inst"], [class*="native-ad"]');
            targets.forEach(el => el.remove());
          };
          killAds();
          window.addEventListener('load', killAds);
          document.addEventListener('astro:page-load', killAds);
          setInterval(killAds, 1000); // Orion: Vigilancia agresiva (1s)
        })();
      </script>
    )}
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <!-- Googlebot Priority -->
    <meta
      name="googlebot"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
    <meta
      name="bingbot"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />

    <!-- Breadcrumbs JSON-LD -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: 'Inicio',
            item: siteUrl,
          },
          ...Astro.url.pathname
            .split('/')
            .filter(Boolean)
            .map((part, i, arr) => ({
              '@type': 'ListItem',
              position: i + 2,
              name:
                part.charAt(0).toUpperCase() + part.slice(1).replace(/-/g, ' '),
              item: `${siteUrl}/${arr.slice(0, i + 1).join('/')}`,
            })),
        ],
      })}
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullOgImage} />

    <!-- Orion: Preconexiones Críticas (Optimización Extrema) -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="preconnect"
      href="https://crowdsubsequentadmire.com"
      crossorigin
    />
    <link rel="dns-prefetch" href="https://crowdsubsequentadmire.com" />
    <link
      rel="preconnect"
      href="https://pagead2.googlesyndication.com"
      crossorigin
    />
    <link
      rel="preconnect"
      href="https://challenges.cloudflare.com"
      crossorigin
    />

    <!-- Astra: Swiper (Carga Dinámica Orion) -->
    <link rel="icon" type="image/png" href={siteConfig.assets.favicon} />
    {import.meta.env.PROD && <link rel="manifest" href="/manifest.json?v=2" />}
    <slot name="head" />

    <style
      is:inline
      define:vars={{
        accent: siteConfig.theme.accent,
        accentGlow: siteConfig.theme.accentGlow,
        bg: siteConfig.theme.background,
        bgAlt: siteConfig.theme.backgroundAlt,
      }}
    >
      /* --- CRITICAL CSS (Prevent FOUC) --- */
      :root {
        --accent-color: var(--accent);
        --accent-glow: var(--accentGlow);
        --bg-color: var(--bg);
        --bg-alt: var(--bgAlt);
      }

      /* Bloqueo inmediato del fondo y color base */
      html {
        background-color: #020205 !important;
        color: #fff;
      }
      body {
        margin: 0;
        padding: 0;
        background-color: #020205;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        overflow-x: hidden;
      }

      /* Reserva de espacio para Header y Hero para evitar saltos */
      .site-header {
        height: 90px;
        background: rgba(2, 2, 5, 0.7);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        position: fixed;
        top: 0;
        width: 100%;
        z-index: 5000;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      }

      .hero-carousel-section {
        min-height: 520px;
        background: #000;
        width: 100%;
      }

      /* Esqueleto de Grillas (Featured y Updates) */
      .featured-grid-3x2 {
        display: grid !important;
        grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)) !important;
        gap: 1.5rem !important;
        min-height: 665px;
        max-height: 665px;
        overflow: hidden;
      }

      /* Esqueleto de Capítulos Premium */
      .chapters-premium-grid {
        display: grid !important;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)) !important;
        gap: 1.25rem !important;
        min-height: 400px;
      }

      .recent-updates-swiper:not(.swiper-initialized) .swiper-wrapper {
        display: flex !important;
        gap: 20px !important;
        overflow: hidden !important;
        min-height: 350px;
      }

      .custom-slide {
        flex-shrink: 0 !important;
        width: 240px !important;
      }

      /* Esqueleto de Cards (Evita el colapso interno) */
      .premium-update-card-wrapper,
      .featured-card-wrapper {
        aspect-ratio: 2 / 3 !important;
        background: rgba(255, 255, 255, 0.03) !important;
        border-radius: 24px !important;
        overflow: hidden !important;
      }

      .featured-card-wrapper {
        height: 320px !important;
        aspect-ratio: auto !important; /* Featured usa altura fija */
      }

      @media (max-width: 1100px) {
        .featured-grid-3x2 {
          grid-template-columns: repeat(2, 1fr) !important;
        }
      }

      @media (max-width: 768px) {
        .site-header {
          height: 80px;
          position: relative;
        }
        .featured-grid-3x2 {
          grid-template-columns: repeat(2, 1fr) !important;
          gap: 1rem !important;
        }
        .recent-updates-swiper:not(.swiper-initialized) .swiper-wrapper {
          gap: 15px !important;
        }
        .custom-slide {
          width: 160px !important;
        }
      }

      /* Ocultar contenido hasta que el navegador procese el CSS principal si es necesario */
      .site-main-content {
        visibility: visible;
        opacity: 1;
      }

      html.nsfw-mode {
        --accent-color: #900000 !important;
        --accent-glow: rgba(144, 0, 0, 0.6) !important;
      }

      /* Orion: Optimización de Renderizado (Aceleración por Hardware) */
      .stars-layer {
        will-change: transform;
        transform: translate3d(0, 0, 0);
        backface-visibility: hidden;
      }
      /* Astra: Limpieza de Slides para el Hero (Evita superposición translúcida) */
      .hero-swiper .swiper-slide {
        opacity: 0 !important;
        transition: opacity 0.6s ease-in-out !important;
        pointer-events: none;
      }
      .hero-swiper .swiper-slide-active {
        opacity: 1 !important;
        pointer-events: auto;
      }

      /* Astra: Capa Fantasma (Shield) */
      .image-wrapper {
        position: relative;
        user-select: none;
        -webkit-user-drag: none;
      }

      /* Este es el "cristal" que intercepta todos los clicks y el inspector */
      .image-wrapper::after {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 10;
        background: transparent;
        cursor: default;
      }

      img {
        pointer-events: none !important;
        -webkit-touch-callout: none !important;
      }

      /* Astra: Estilos para Contenedores de Anuncios */
      .ad-container-root {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        margin: 0;
        min-height: 0;
        background: transparent;
        border-radius: 16px;
        overflow: hidden !important;
        position: relative;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .ad-container-root.square {
        height: auto;
        margin: 0 auto;
      }

      .ad-inner-wrapper {
        position: relative;
        z-index: 1;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      /* --- CRITICAL SKELETON (Prevent FOUC) --- */
      body {
        background-color: #020205;
        margin: 0;
        color: #fff;
        font-family: system-ui, sans-serif;
      }
      .site-header {
        height: 90px;
        width: 100%;
        background: #020205;
        position: absolute;
        top: 0;
        z-index: 5000;
      }
      .hero-carousel-section {
        min-height: 520px;
        background: #000;
        width: 100vw;
        overflow: hidden;
      }
      .site-main-content {
        min-height: auto;
        display: flex;
        flex-direction: column;
      }
      @media (max-width: 1023px) {
        .site-header {
          height: 80px;
          position: relative;
        }
      }

      /* Orion: Padding condicional para páginas que no son la Home */
      @media (min-width: 1024px) {
        .padded-content {
          padding-top: 90px;
        }
      }
    </style>
    {
      /* Astra: Ad Optimizer v1.0 - Gestión unificada de scripts de publicidad */
      /* Orion: Bloqueo de seguridad nuclear para Staff (Admins y Scanlations) */
      siteConfig.ads.enabled && 
      !Astro.locals.isStaff && 
      !user?.isAdmin && (
        <script
          is:inline
          define:vars={{
            monetag: siteConfig.ads.monetag,
            adsterra: siteConfig.ads.adsterra
          }}
        >
          (function() {
            // 1. Cargador inteligente para Monetag (Evita duplicados)
            const loadedScripts = new Set();
            const injectMonetag = (url, zone, type = 'multitag') => {
              if (!url || !zone || loadedScripts.has(url + zone)) return;
              loadedScripts.add(url + zone);

              const s = document.createElement('script');
              s.src = url;
              s.dataset.zone = zone;
              s.async = true;
              s.dataset.cfasync = "false";
              
              if (type === 'vignette') {
                const target = [document.documentElement, document.body].filter(Boolean).pop();
                if (target) target.appendChild(s);
              } else {
                document.head.appendChild(s);
              }
            };

            // Inyectamos Monetag con prioridad
            if (monetag?.vignetteUrl) injectMonetag(monetag.vignetteUrl, monetag.vignetteId, 'vignette');
            if (monetag?.multitagUrl) injectMonetag(monetag.multitagUrl, monetag.multitagId);
            
            // El multitag 2 solo se inyecta si es una URL distinta al primero (evita doble carga de .js)
            if (monetag?.multitag2Url && monetag.multitag2Url !== monetag.multitagUrl) {
              injectMonetag(monetag.multitag2Url, monetag.multitag2Id);
            }

            // 2. Cargador diferido para Adsterra (Mejora el LCP/FCP)
            const injectAdsterra = (url) => {
              if (!url) return;
              const s = document.createElement('script');
              s.src = url;
              s.async = true;
              document.head.appendChild(s);
            };

            // Diferimos la carga de Adsterra 1.5s para priorizar el contenido real del sitio
            const triggerAdsterra = () => {
              setTimeout(() => {
                if (adsterra?.socialBarUrl) injectAdsterra(adsterra.socialBarUrl);
                if (adsterra?.popunderUrl) injectAdsterra(adsterra.popunderUrl);
              }, 1500);
            };

            if (document.readyState === 'complete') triggerAdsterra();
            else window.addEventListener('load', triggerAdsterra);
          })();
        </script>
      )
    }
  </head>
  <body
    class="cosmos-theme"
    style="opacity: 0; transition: opacity 0.2s ease;"
    data-user-id={user?.uid || 'guest'}
    data-user-state={user
      ? JSON.stringify({
          uid: user.uid,
          email: user.email,
          isAdmin: user.isAdmin,
          scanlations: user.scanlations,
        })
      : 'null'}
    data-cosmos-physics={siteConfig.theme.cosmos.physicsEnabled
      ? 'true'
      : 'false'}
    data-news-count={serverNewsCount}
    data-is-dev={import.meta.env.DEV ? 'true' : 'false'}
    data-sl-adult={slAdult || 'MISSING_ADULT'}
    data-sl-main={slMain || 'MISSING_MAINSTREAM'}
    data-sl-extra={slExtra || ''}
    data-sl-monetag={slMonetag || ''}
    data-sl-monetag-2={slMonetag2 || ''}
    data-sl-monetag-3={slMonetag3 || ''}
    data-adsterra-domain={siteConfig.ads.adsterra.domain}
  >
    <script is:inline>
      // Astra: Blindaje Anti-FOUC Nuclear
      (function () {
        const show = () => (document.body.style.opacity = '1');
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', show);
        } else {
          show();
        }
        // Fallback de seguridad por si algo falla
        setTimeout(show, 150);
      })();
    </script>
    {
      siteConfig.theme.cosmos.enabled && (
        <div class="cosmos-bg">
          <div
            class="stars-layer base"
            style="transform: translate3d(calc(var(--cosmos-tx) * -0.02), calc(var(--cosmos-sy) * -0.02 + var(--cosmos-ty) * -0.02), 0)"
          />
          <div
            class="stars-layer mid"
            style="transform: translate3d(calc(var(--cosmos-tx) * -0.06), calc(var(--cosmos-sy) * -0.06 + var(--cosmos-ty) * -0.06), 0)"
          />
          <div
            class="stars-layer dust"
            style="transform: translate3d(calc(var(--cosmos-tx) * -0.12), calc(var(--cosmos-sy) * -0.12 + var(--cosmos-ty) * -0.12), 0)"
          />
          <div class="nebula-glow" />
          <div class="shooting-stars">
            <>
              <span />
              <span />
              <span />
            </>
          </div>
        </div>
      )
    }

    {
      shouldBlockContent ? (
        <div class="content-blocked-placeholder" />
      ) : (
        <>
          {!isVerifyPage && <Header />}
          <main class="site-main-content">
            <slot />
          </main>
          {!isVerifyPage && isMobile && <BottomNav />}
          {!isVerifyPage && <Footer />}
        </>
      )
    }

    <div id="global-utilities-root"></div>
    {!isAdminPage && <AdblockWall />}

    <script is:inline>
      (function () {
        // 1. Blindaje Crítico (Astra Orion: Seguridad Activa)
        window.addEventListener('contextmenu', (e) => e.preventDefault(), {
          capture: true,
          passive: false,
        });
        window.addEventListener('dragstart', (e) => e.preventDefault(), {
          capture: true,
