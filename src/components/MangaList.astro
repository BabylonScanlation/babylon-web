---
import type { Series } from '../types';
import LibraryCard from './LibraryCard.astro';

interface Props {
  mangas: Series[];
  title?: string;
}

const { mangas = [], title } = Astro.props;
---

<section class="manga-list-section">
  {title && <h2>{title}</h2>}
  <ul>
    {
      mangas && mangas.length > 0 ? (
        mangas.map((manga) => (
          <li>
            <LibraryCard manga={manga} />
          </li>
        ))
      ) : (
        <p>No hay mangas en la biblioteca.</p>
      )
    }
  </ul>
</section>

<style>
  /* ✅ CAMBIO: Eliminamos padding para que se ajuste al nuevo marco */
  .manga-list-section {
    padding: 0;
  }
  h2 {
    font-size: 1.8rem;
    margin-bottom: 1.5rem;
    color: #eee;
    padding-bottom: 0.5rem;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
  }
  ul {
    list-style: none;
    padding: 0;
    display: grid !important;
    /* Astra: Grilla Fluida Universal */
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    /* Astra: Límite estricto e inviolable de 3 filas */
    grid-template-rows: repeat(3, auto) !important;
    grid-auto-rows: 0px !important;
    overflow: hidden !important;
    gap: 1rem;
    margin-bottom: 3rem;
    align-content: start;
  }

  /* Aseguramos que los items fuera de las 3 filas no ocupen espacio visual ni de margen */
  ul li {
    overflow: hidden;
  }

  /* Tablet/Desktop: Ajustamos el tamaño mínimo para tarjetas más grandes si hay espacio */
  @media (min-width: 768px) {
    ul {
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 1.5rem;
      margin-bottom: 5rem;
    }
  }

  /* Pantallas Ultra-Anchas: Máximo aprovechamiento del espacio */
  @media (min-width: 1440px) {
    ul {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 2rem;
    }
  }
  p {
    color: #aaa;
    font-style: italic;
  }
</style>
