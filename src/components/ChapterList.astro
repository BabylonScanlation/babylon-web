---
import { timeAgo } from '../lib/utils';

interface Chapter {
  id: number;
  chapterNumber: number;
  title: string | null;
  createdAt: string | number | Date;
  views: number | null;
  status: string;
  scanlationName?: string | null;
}

interface Props {
  chaptersByLanguage: Record<string, Chapter[]>;
  seriesSlug: string;
}

const { chaptersByLanguage, seriesSlug } = Astro.props;

// Ordenamos los idiomas para que el español aparezca primero si existe
const languages = Object.keys(chaptersByLanguage).sort((a, b) => {
  if (a === 'es-la' || a === 'es-es') return -1;
  if (b === 'es-la' || b === 'es-es') return 1;
  return a.localeCompare(b);
});

const languageNames: Record<string, string> = {
  'es-la': 'Español Latino',
  'es-es': 'Español España',
  en: 'Inglés',
  pt: 'Portugués',
  raw: 'Raw / Crudo',
};
---

<script>
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('.app-chapter-link');
    if (target) {
      e.preventDefault();
      document.dispatchEvent(new CustomEvent('open-app-modal'));
    }
  });
</script>

<div class="chapters-aggregator-container">
  {languages.length > 0 ? (
    languages.map((lang) => (
      <div class="language-section">
        <div class="language-header">
          <span class="lang-flag">{lang.toUpperCase()}</span>
          <h3 class="lang-title">{languageNames[lang] || lang}</h3>
          <div class="lang-line"></div>
        </div>

        <div class="list-scroll-area">
          {(chaptersByLanguage[lang] || [])
            .sort((a, b) => b.chapterNumber - a.chapterNumber)
            .map((chapter) => {
              const isAppOnly = chapter.status === 'app_only';
              return (
                <div class="chapter-item-wrapper">
                  <a 
                    href={isAppOnly ? '#' : `/series/${seriesSlug}/${chapter.chapterNumber}?id=${chapter.id}`} 
                    class:list={['chapter-card-link', { 'app-chapter-link': isAppOnly }]}
                  >
                    <div class="card-left">
                      <div class="chapter-badge-num">
                        <span class="label">CAP</span>
                        <span class="number">{chapter.chapterNumber}</span>
                      </div>
                      <div class="chapter-info">
                        <h4 class="chapter-title">
                          {chapter.title ? chapter.title.trim() : `Capítulo ${chapter.chapterNumber}`}
                        </h4>
                        <div class="chapter-meta">
                          {chapter.scanlationName && (
                            <span class="meta-data scan">
                              <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2.5" fill="none"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                              {chapter.scanlationName}
                            </span>
                          )}
                          <span class="meta-data date">
                            <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2.5" fill="none"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                            {timeAgo(chapter.createdAt)}
                          </span>
                        </div>
                      </div>
                    </div>

                    <div class="card-right">
                      {isAppOnly ? (
                        <div class="app-status-badge">
                          <span>APP ONLY</span>
                        </div>
                      ) : (
                        <div class="read-action">
                          <span class="read-text">LEER</span>
                          <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="3" fill="none"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        </div>
                      )}
                    </div>
                  </a>
                </div>
              )
            })}
        </div>
      </div>
    ))
  ) : (
    <div class="empty-chapters">
      <svg viewBox="0 0 24 24" width="48" height="48" stroke="currentColor" stroke-width="1.5" fill="none" opacity="0.2"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><polyline points="13 2 13 9 20 9"></polyline></svg>
      <p>Aún no hay capítulos disponibles.</p>
    </div>
  )}
</div>

<style>
  .chapters-aggregator-container {
    width: 100%;
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .language-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .language-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0 0.5rem;
  }

  .lang-flag {
    background: #222;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 0.65rem;
    font-weight: 900;
    color: var(--accent-color);
    border: 1px solid rgba(0, 191, 255, 0.2);
  }

  .lang-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: #fff;
    margin: 0;
    white-space: nowrap;
  }

  .lang-line {
    height: 1px;
    background: linear-gradient(90deg, #333 0%, transparent 100%);
    flex: 1;
  }

  .list-scroll-area {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
  }

  .chapter-item-wrapper {
    position: relative;
    width: 100%;
  }

  .chapter-card-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255,255,255,0.02);
    border: 1px solid #1a1a1a;
    border-radius: 16px;
    padding: 0.75rem 1.25rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .chapter-card-link:hover {
    background: #16161a;
    border-color: var(--accent-color);
    transform: translateX(4px);
  }

  .card-left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-width: 0;
    flex: 1;
  }

  .chapter-badge-num {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #000;
    border: 1px solid #222;
    min-width: 50px;
    height: 50px;
    border-radius: 10px;
  }

  .chapter-badge-num .label { font-size: 0.55rem; color: #555; font-weight: 900; }
  .chapter-badge-num .number { font-size: 1.1rem; font-weight: 900; color: #fff; }

  .chapter-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .chapter-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #eee;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .chapter-meta {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .meta-data {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: #666;
  }

  .meta-data.scan {
    color: var(--accent-color);
    opacity: 0.8;
  }

  .card-right {
    display: flex;
    align-items: center;
    margin-left: 1rem;
  }

  .read-action {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #444;
    font-size: 0.75rem;
    font-weight: 900;
  }

  .chapter-card-link:hover .read-action {
    color: var(--accent-color);
  }

  .empty-chapters {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 4rem 0;
    color: #333;
  }

  @media (max-width: 640px) {
    .chapters-aggregator-container { gap: 2rem; }
    .chapter-card-link { padding: 0.65rem 1rem; }
    .chapter-badge-num { min-width: 44px; height: 44px; }
    .chapter-badge-num .number { font-size: 0.95rem; }
    .read-text { display: none; }
  }
</style>

<style>
  .chapters-premium-list {
    width: 100%;
    margin-top: 1rem;
    min-width: 0;
  }

  .list-scroll-area {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-height: 600px;
    overflow-y: auto;
    padding-right: 0.25rem;
    width: 100%;
    min-width: 0;
  }

  /* Chapter Card */
  .chapter-item-wrapper {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  .chapter-card-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #111;
    border: 1px solid #1a1a1a;
    border-radius: 16px;
    padding: 1rem 1.5rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    min-width: 0; /* Allow shrinking */
  }

  .chapter-card-link:hover {
    background: #16161a;
    border-color: var(--accent-color);
    transform: translateX(4px);
  }

  .card-left {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-width: 0; /* Allow shrinking */
    flex: 1; /* Take available space */
  }

  .chapter-badge-num {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid #222;
    min-width: 60px;
    height: 60px;
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .chapter-card-link:hover .chapter-badge-num {
    background: rgba(0, 191, 255, 0.1);
    border-color: var(--accent-color);
  }

  .chapter-badge-num .label {
    font-size: 0.6rem;
    font-weight: 900;
    color: #444;
    letter-spacing: 0.1em;
  }

  .chapter-badge-num .number {
    font-size: 1.25rem;
    font-weight: 900;
    color: #fff;
    line-height: 1;
  }

  .chapter-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0; /* Allow shrinking for text overflow */
    flex: 1;
  }

  .chapter-title {
    font-size: 1rem;
    font-weight: 700;
    color: #eee;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .chapter-meta {
    display: flex;
    gap: 1rem;
  }

  .meta-data {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #555;
  }

  /* Card Right */
  .card-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .read-action {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #444;
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    transition: all 0.3s ease;
  }

  .chapter-card-link:hover .read-action {
    color: var(--accent-color);
    transform: translateX(5px);
  }

  .app-status-badge {
    background: rgba(252, 163, 17, 0.1);
    color: #fca311;
    border: 1px solid rgba(252, 163, 17, 0.2);
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 0.7rem;
    font-weight: 900;
    display: flex;
    align-items: center;
    gap: 6px;
    letter-spacing: 0.05em;
  }

  .empty-chapters {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 0;
    color: #333;
    gap: 1rem;
  }

  /* Scrollbar */
  .list-scroll-area::-webkit-scrollbar {
    width: 4px;
  }
  .list-scroll-area::-webkit-scrollbar-track {
    background: transparent;
  }
  .list-scroll-area::-webkit-scrollbar-thumb {
    background: #222;
    border-radius: 10px;
  }
  .list-scroll-area::-webkit-scrollbar-thumb:hover {
    background: #333;
  }

  @media (max-width: 640px) {
    .chapter-card-link { padding: 0.75rem; border-radius: 12px; gap: 0.5rem; }
    .chapter-card-link:hover { transform: none; } /* Disable shift on mobile */
    .card-left { gap: 0.75rem; }
    .chapter-badge-num { min-width: 42px; width: 42px; height: 42px; }
    .chapter-badge-num .number { font-size: 0.95rem; }
    .chapter-badge-num .label { font-size: 0.5rem; }
    .chapter-title { font-size: 0.85rem; }
    .chapter-meta { gap: 0.5rem; flex-wrap: wrap; }
    .card-right { gap: 0.5rem; }
    .read-text { display: none; }
    .meta-data.views { display: flex; font-size: 0.65rem; color: #444; }
  }
</style>
