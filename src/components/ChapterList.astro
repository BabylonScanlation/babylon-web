---
import { timeAgo } from '../lib/utils';

interface Chapter {
  id: number;
  chapterNumber: number;
  title: string | null;
  createdAt: string | number | Date;
  views: number | null;
  status: string;
  scanlationName?: string | null;
  isNsfw?: boolean;
}

interface Props {
  chaptersByLanguage: Record<string, Chapter[]>;
  seriesSlug: string;
  seriesIsUpToDate?: boolean;
}

const { chaptersByLanguage, seriesSlug, seriesIsUpToDate } = Astro.props;

const allChapters = Object.values(chaptersByLanguage).flat();
const maxChapterNumber =
  allChapters.length > 0 ? Math.max(...allChapters.map((ch) => ch.chapterNumber)) : -1;

// Ordenamos los idiomas para que el español aparezca primero si existe
const languages = Object.keys(chaptersByLanguage).sort((a, b) => {
  if (a === 'es-la' || a === 'es-es') return -1;
  if (b === 'es-la' || b === 'es-es') return 1;
  return a.localeCompare(b);
});

const languageNames: Record<string, string> = {
  'es-la': 'Español Latino',
  'es-es': 'Español España',
  'en-us': 'Inglés (EE.UU.)',
  'en-gb': 'Inglés (Reino Unido)',
  en: 'Inglés',
  pt: 'Portugués',
  raw: 'Raw / Crudo',
};
---

<script>
  function handleToggle(e: Event) {
    const header = (e.target as HTMLElement).closest('.language-header.is-collapsible');
    if (!header) return;

    const section = header.closest('.language-section');
    if (!section) return;
    
    const isCollapsed = section.classList.toggle('is-collapsed');
    const arrow = header.querySelector('.collapse-arrow');
    
    // Astra: Animación de flecha
    if (arrow) {
      (arrow as HTMLElement).style.transform = isCollapsed ? 'rotate(-90deg)' : 'rotate(0deg)';
    }
  }

  // Delegación de eventos para máxima compatibilidad
  document.addEventListener('click', handleToggle);

  // App Modal Logic
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('.app-chapter-link');
    if (target) {
      e.preventDefault();
      document.dispatchEvent(new CustomEvent('open-app-modal'));
    }
  });
</script>

<script>
  // Script para manejar el toggle de grupos de capítulos en el grid
  document.addEventListener('DOMContentLoaded', () => {
    const toggles = document.querySelectorAll('.chapter-group-toggle');
    
    toggles.forEach(toggle => {
      toggle.addEventListener('click', (e) => {
        // Evitar que el clic en enlaces internos dispare el toggle (si hubiera)
        if ((e.target as HTMLElement).closest('a')) return;
        
        const targetId = toggle.getAttribute('data-target');
        if (!targetId) return;
        
        const subItems = document.querySelectorAll(`.${targetId}`);
        const isOpen = toggle.classList.contains('is-open');
        
        if (isOpen) {
          toggle.classList.remove('is-open');
          subItems.forEach((el) => {
            (el as HTMLElement).style.display = 'none';
          });
        } else {
          toggle.classList.add('is-open');
          subItems.forEach((el) => {
            (el as HTMLElement).style.display = 'block'; // Or whatever display was default, block works for grid items because they become block-level children of grid
          });
        }
      });
    });
  });
</script>

<div class="chapters-aggregator-container">
  {languages.length > 0 ? (
    languages.map((lang) => (
      <div class="language-section" id={`lang-section-${lang}`}>
        <button class="language-header is-collapsible" aria-label={`Colapsar capítulos en ${languageNames[lang.toLowerCase()] || lang}`}>
          <div class="header-left">
            <span class="lang-flag">{lang.toUpperCase()}</span>
            <h3 class="lang-title">{languageNames[lang.toLowerCase()] || lang}</h3>
          </div>
          <div class="lang-line"></div>
          <div class="collapse-arrow">
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="3" fill="none"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </div>
        </button>

        <div class="chapters-premium-grid">
          {(() => {
            const rawChapters = chaptersByLanguage[lang] || [];
            
            const grouped = rawChapters.reduce((acc, chapter) => {
              if (!acc[chapter.chapterNumber]) acc[chapter.chapterNumber] = [];
              acc[chapter.chapterNumber].push(chapter);
              return acc;
            }, {} as any);

            const groupedArray = Object.entries(grouped)
              .map(([num, list]: [string, any]) => ({
                chapterNumber: parseFloat(num),
                chapters: list.sort((a: any, b: any) => new Date(b.createdAt || 0).getTime() - new Date(a.createdAt || 0).getTime())
              }))
              .sort((a, b) => b.chapterNumber - a.chapterNumber);

            return groupedArray.map((group) => {
              const { chapterNumber, chapters: groupChapters } = group;

              const renderChapterCard = (chapter: any, isSubItem = false, groupId = '') => {
                const isAppOnly = chapter.status === 'app_only';
                return (
                  <div class={`chapter-card-wrapper ${isSubItem ? 'sub-item' : ''} ${groupId}`} style={isSubItem ? 'display: none;' : ''}>
                    <a 
                      href={isAppOnly ? '#' : `/series/${seriesSlug}/${chapter.chapterNumber}?id=${chapter.id}`} 
                      class:list={['chapter-card-premium', { 'app-chapter-link': isAppOnly }]}
                    >
                      <div class="card-bg-glow"></div>
                      <div class="watermark-num">{chapter.chapterNumber}</div>
                      
                      <div class="card-content">
                        <div class="chapter-main">
                          <div class="chapter-label-row">
                            <div class="label-left">
                              <span class="chapter-label">CAPÍTULO</span>
                              {chapter.scanlationName && (
                                <span class="scanlation-badge">{chapter.scanlationName}</span>
                              )}
                            </div>
                            {chapter.views !== null && (
                              <div class="meta-item views-top">
                                <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="3" fill="none"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                <span>{chapter.views.toLocaleString()}</span>
                              </div>
                            )}
                          </div>
                          <h4 class="chapter-num">
                            {chapter.chapterNumber}
                            <div class="chapter-tags">
                              {seriesIsUpToDate && chapter.chapterNumber === maxChapterNumber && !isSubItem && (
                                <span class="tag-al-dia">AL DÍA</span>
                              )}
                              {chapter.isNsfw && (
                                <span class="tag-nsfw">NSFW</span>
                              )}
                            </div>
                          </h4>
                          <p class="chapter-title">
                            {chapter.title ? chapter.title.trim() : `Nueva Actualización`}
                          </p>
                        </div>

                        <div class="chapter-meta-row">
                          <div class="meta-item date">
                            <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="3" fill="none"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                            <span>{timeAgo(chapter.createdAt)}</span>
                          </div>
                        </div>
                      </div>

                      <div class="card-action">
                        {isAppOnly ? (
                          <div class="status-badge app-only">
                            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="3" fill="none"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                            <span>APP ONLY</span>
                          </div>
                        ) : (
                          <div class="status-badge read">
                            <span>LEER</span>
                            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="3" fill="none"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                          </div>
                        )}
                      </div>
                    </a>
                  </div>
                );
              };

              if (groupChapters.length === 1) {
                return renderChapterCard(groupChapters[0]);
              } else {
                const hasNsfw = groupChapters.some((c: any) => c.isNsfw);
                const hasAlDia = seriesIsUpToDate && chapterNumber === maxChapterNumber;
                
                const groupId = `group-${lang}-${chapterNumber}`.replace(/\s+/g, '-');
                return (
                  <>
                    <div class="chapter-card-wrapper chapter-group-toggle" data-target={groupId} style="cursor: pointer;">
                      <div class="chapter-card-premium group-summary">
                        <div class="card-bg-glow"></div>
                        <div class="watermark-num">{chapterNumber}</div>
                        
                        <div class="card-content">
                          <div class="chapter-main">
                            <div class="chapter-label-row">
                              <div class="label-left">
                                <span class="chapter-label">CAPÍTULO</span>
                                <span class="scanlation-badge versions-badge">{groupChapters.length} Versiones</span>
                              </div>
                            </div>
                            <h4 class="chapter-num">
                              {chapterNumber}
                              <div class="chapter-tags">
                                {hasAlDia && <span class="tag-al-dia">AL DÍA</span>}
                                {hasNsfw && <span class="tag-nsfw">NSFW</span>}
                              </div>
                            </h4>
                            <p class="chapter-title">Múltiples opciones disponibles</p>
                          </div>
                        </div>

                        <div class="card-action">
                          <div class="status-badge expand-badge">
                            <span>VER</span>
                            <svg class="expand-icon" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="3" fill="none"><polyline points="6 9 12 15 18 9"></polyline></svg>
                          </div>
                        </div>
                      </div>
                    </div>
                    {groupChapters.map((c: any) => renderChapterCard(c, true, groupId))}
                  </>
                );
              }
            });
          })()}
        </div>
      </div>
    ))
  ) : (
    <div class="empty-chapters">
      <svg viewBox="0 0 24 24" width="48" height="48" stroke="currentColor" stroke-width="1.5" fill="none" opacity="0.2"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><polyline points="13 2 13 9 20 9"></polyline></svg>
      <p>Aún no hay capítulos disponibles.</p>
    </div>
  )}
</div>

<style>
  .chapters-aggregator-container {
    width: 100%;
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .language-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
.language-header {
  all: unset;
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0.75rem 1rem;
  width: 100%;
  cursor: pointer;
  border-radius: 12px;
  transition: background 0.2s;
  box-sizing: border-box;
}

.language-header:hover {
  background: rgba(255, 255, 255, 0.03);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.collapse-arrow {
  color: #444;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  align-items: center;
  margin-left: 1rem;
}

.language-header:hover .collapse-arrow {
  color: var(--accent-color);
}

.language-section.is-collapsed .chapters-premium-grid {
  display: none !important;
}
.language-section.is-collapsed .language-header {
  opacity: 0.6;
}

.lang-flag {
...
    background: #222;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 0.65rem;
    font-weight: 900;
    color: var(--accent-color);
    border: 1px solid rgba(0, 191, 255, 0.2);
  }

  .lang-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: #fff;
    margin: 0;
    white-space: nowrap;
  }

  .lang-line {
    height: 1px;
    background: linear-gradient(90deg, #333 0%, transparent 100%);
    flex: 1;
  }

  /* PREMIUM CHAPTERS GRID */
  .chapters-premium-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.75rem;
    width: 100%;
    margin-top: 1rem;
  }

  @media (min-width: 640px) {
    .chapters-premium-grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1rem;
    }
  }

  @media (min-width: 1024px) {
    .chapters-premium-grid {
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); /* Astra: Mas ancho para evitar saltos de linea */
      gap: 1.25rem;
    }
  }

  @media (min-width: 1600px) {
    .chapters-premium-grid {
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    }
  }

  .chapter-card-wrapper {
    position: relative;
    z-index: 1;
    display: block;
    height: 100%;
    min-height: 140px;
  }

  .chapter-card-premium {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 1.25rem;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    height: 100%; 
    contain: content;
    will-change: transform;
  }

  .chapter-card-wrapper:hover .chapter-card-premium {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-4px);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
  }

  .card-bg-glow {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(circle at 100% 0%, var(--accent-glow, rgba(0, 191, 255, 0.1)), transparent 50%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
    z-index: 0;
  }

  .chapter-card-wrapper:hover .card-bg-glow { opacity: 1; }

  .card-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex-grow: 1;
  }

  .chapter-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between; /* Astra: Empuja vistas a la derecha */
    gap: 0.75rem;
    margin-bottom: 0.2rem;
  }

  .label-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .chapter-label {
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: #555;
    text-transform: uppercase;
  }

  .scanlation-badge {
    font-size: 0.6rem;
    font-weight: 900;
    color: var(--accent-color);
    background: rgba(0, 191, 255, 0.05);
    border: 1px solid rgba(0, 191, 255, 0.2);
    padding: 2px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }


  .chapter-num {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.75rem;
    font-weight: 800;
    color: #fff;
    line-height: 1;
    margin: 0 0 0.5rem 0;
  }

  .chapter-title {
    font-size: 0.85rem;
    color: #aaa;
    font-weight: 500;
    line-height: 1.3;
    margin: 0;
  }

  .chapter-tags {
    display: flex;
    flex-direction: row;
    gap: 0.25rem;
    align-items: center;
  }

  .chapter-tags:empty {
    display: none;
  }

  .tag-al-dia {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    background: #00bfff;
    color: #fff;
    font-size: 0.57rem;
    font-weight: 800;
    padding: 4px 6px;
    border-radius: 4px;
    white-space: nowrap;
    box-shadow: 0 0 8px rgba(0, 191, 255, 0.8), 0 0 16px rgba(0, 191, 255, 0.4);
  }
  
  .tag-nsfw {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    background: #ff69b4;
    color: #fff;
    font-size: 0.57rem;
    font-weight: 800;
    padding: 4px 6px;
    border-radius: 4px;
    white-space: nowrap;
    box-shadow: 0 0 8px rgba(255, 105, 180, 0.8), 0 0 16px rgba(255, 105, 180, 0.4);
  }

  .chapter-meta-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: auto;
    padding-right: 3.5rem; /* Astra: Espacio optimizado */
  }

  .meta-item {
    display: flex;
    align-items: center; /* Astra: Alineacion vertical perfecta */
    gap: 0.4rem;
    font-size: 0.7rem;
    color: #666;
    font-weight: 600;
    white-space: nowrap;
    line-height: 1; /* Astra: Evita desplazamientos por altura de linea */
  }

  .meta-item svg {
    display: block; /* Astra: Evita saltos de baseline */
  }

  .card-action {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    z-index: 3;
  }

  .status-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.2rem; /* Reducido por el espacio vacío del SVG */
    padding: 0.35rem 0.7rem 0.45rem 0.9rem; /* Ajuste óptico: empuja arriba y a la derecha */
    border-radius: 100px;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    line-height: 1;
    transition: all 0.2s;
  }

  .status-badge.read svg {
    margin-right: -0.25rem; /* Compensar el espacio vacío dentro del SVG a la derecha */
  }

  .status-badge.read {
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .chapter-card-wrapper:hover .status-badge.read {
    background: var(--accent-color);
    color: #000;
    border-color: var(--accent-color);
  }

  .status-badge.app-only {
    background: rgba(252, 163, 17, 0.1);
    color: #fca311;
    border: 1px solid rgba(252, 163, 17, 0.2);
  }

  .watermark-num {
    position: absolute;
    top: -1rem;
    right: -0.5rem;
    font-size: 6rem;
    font-weight: 900;
    color: rgba(255, 255, 255, 0.02);
    z-index: 1;
    pointer-events: none;
    line-height: 1;
    user-select: none;
    transition: transform 0.4s ease, color 0.4s ease;
  }

  .chapter-card-wrapper:hover .watermark-num {
    transform: translateY(-5px) scale(1.05);
    color: rgba(255, 255, 255, 0.04);
  }

  .empty-chapters {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 4rem 0;
    color: #333;
  }
  
  .app-chapter-link .card-content {
    opacity: 0.8;
  }

  /* Group container styles */
  .group-summary {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: linear-gradient(145deg, rgba(30, 32, 40, 0.9), rgba(20, 22, 28, 0.95));
  }
  
  .chapter-group-toggle.is-open .group-summary {
    border-color: rgba(99, 102, 241, 0.4);
    box-shadow: 0 0 20px rgba(99, 102, 241, 0.15);
  }

  .chapter-group-toggle.is-open .expand-icon {
    transform: rotate(180deg);
  }
  
  .expand-icon {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .versions-badge {
    background: rgba(255, 255, 255, 0.1) !important;
    color: rgba(255, 255, 255, 0.9) !important;
  }
  
  .sub-item .chapter-card-premium {
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.02), rgba(0, 0, 0, 0.2));
    border-color: rgba(255, 255, 255, 0.04);
    min-height: 85px;
    padding: 1rem 1.25rem;
    box-shadow: none;
  }

  .sub-item .chapter-card-premium:hover {
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.04), rgba(0, 0, 0, 0.1));
    border-color: rgba(255, 255, 255, 0.08);
  }
  
  @keyframes slideDown {
    from { 
      opacity: 0; 
      transform: translateY(-10px) scaleY(0.95); 
    }
    to { 
      opacity: 1; 
      transform: translateY(0) scaleY(1); 
    }
  }

  @media (max-width: 640px) {
    .chapters-aggregator-container { gap: 2rem; }
    
    .chapter-card-wrapper {
      height: auto;
      min-height: auto;
    }

    .chapter-card-premium {
      display: grid;
      grid-template-columns: 1fr 85px;
      grid-template-rows: auto auto auto;
      align-items: center;
      gap: 0.15rem 1rem;
      padding: 0.8rem 1rem;
      height: auto;
      background: rgba(255, 255, 255, 0.01);
      border-radius: 12px;
    }

    .chapter-card-wrapper:hover .chapter-card-premium {
      transform: none;
      background: rgba(255, 255, 255, 0.03);
    }

    .card-content, .chapter-main, .chapter-meta-row, .chapter-label-row {
      display: contents;
    }

    .label-left {
      display: none; /* Ocultamos etiquetas de scanlation en movil */
    }

    .chapter-title {
      grid-column: 1;
      grid-row: 1;
      align-self: center;
      font-size: 1rem;
      font-weight: 700;
      color: #fff;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin: 0;
    }

    .meta-item.date {
      grid-column: 1;
      grid-row: 2;
      align-self: end;
      font-size: 0.75rem;
      color: #888;
      text-align: left;
      font-weight: 600;
      white-space: nowrap;
      margin: 0;
    }

    .meta-item.views-top {
      grid-column: 1;
      grid-row: 3;
      align-self: start;
      font-size: 0.75rem;
      color: #555; /* Un poco más oscuro que la fecha (#888) */
      justify-content: flex-start;
      margin: 0;
      border-top: none;
      padding-top: 0;
    }

    .meta-item.views-top svg {
      width: 13px;
      height: 13px;
    }

    .chapter-num {
      grid-column: 2;
      grid-row: 1;
      align-self: center;
      justify-self: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
      font-size: 1.6rem;
      margin: 0;
      color: var(--accent-color);
      text-align: center;
      font-weight: 900;
      line-height: 1;
    }

    .card-action {
      grid-column: 2;
      grid-row: 2 / span 2;
      align-self: center;
      justify-self: center;
      position: static;
