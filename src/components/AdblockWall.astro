---
---
<!-- src/components/AdblockWall.astro -->
<div id="app-shield-root" class="site-verification-mask" style="display: none;">
  <div class="premium-alert-inner">
    <div class="wall-header">
      <div class="wall-icon-container">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shield-icon"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
      </div>
      <h2 id="wall-title">Bloqueador Detectado</h2>
    </div>
    
    <div class="wall-body">
      <p id="wall-message">
        Para seguir leyendo gratis, por favor desactiva tu <strong>bloqueador de anuncios</strong>. Los anuncios mantienen vivo este proyecto.
      </p>
      
      <div class="browser-tip">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        <p>Revisa también tus <span>DNS (AdGuard/NextDNS)</span>, VPN o el escudo del navegador.</p>
      </div>
    </div>

    <div class="wall-actions">
      <button id="verify-shield-btn" class="btn-verify">
        VERIFICAR AHORA
      </button>
    </div>
  </div>
</div>

<!-- Astra: Elementos Cebo Múltiples -->
<div id="tester-wrap" class="ad-unit ad-box ads-container pub_300x250 ads-banner" style="position: absolute; left: -9999px; top: -9999px; width: 1px; height: 1px; opacity: 0.01; pointer-events: none;">&nbsp;</div>

<!-- Banner de aviso suave -->
<div id="system-notification-toast" class="soft-notice-wrapper" style="display: none;">
  <span class="toast-text">🛡️ Considera apoyar el proyecto desactivando el bloqueador.</span>
  <button class="close-toast" onclick="document.getElementById('system-notification-toast').style.display='none'">&times;</button>
</div>

<script>
  /**
   * MONITOR DE INTEGRIDAD (PDF-Strict)
   * Basado en la detección de inyección de código y alteración de objetos.
   */

  let _isBlocked = false;
  const isReaderPage = window.location.pathname.includes('/series/') && window.location.pathname.split('/').filter(Boolean).length >= 3;

  async function checkIntegrity() {
    console.log('%c🛡️ SHIELD: Iniciando monitor de integridad...', 'color: cyan; font-weight: bold;');
    let score = 0;

    // 1. Detección de "Mocks" (PDF: Honeypot de Objetos)
    // Si adsbygoogle existe pero no es un Array real o su .push es falso, hay bloqueo.
    const win = window as any;
    win.adsbygoogle = win.adsbygoogle || [];
    if (win.adsbygoogle.constructor !== Array || 
        (win.adsbygoogle.push && win.adsbygoogle.push.toString().length < 40)) {
      console.log('%c🛡️ SHIELD: Mock detectado en objetos de anuncios.', 'color: orange;');
      score += 1;
    }

    // 2. Detección de Parche de Funciones (PDF: Scriptlet Injection Detection)
    // uBlock y Brave a menudo parchean fetch o XHR.
    if (!window.fetch.toString().includes('[native code]')) {
      console.log('%c🛡️ SHIELD: Función Fetch manipulada por tercero.', 'color: orange;');
      score += 1;
    }

    // 3. Detección de Bloqueo de Red Duro (Sin 403)
    // Probamos con un píxel de tracking de Google. Si falla con error de red pero el sitio carga, es bloqueo.
    const isControlBlocked = await new Promise((resolve) => {
      const img = new Image();
      img.src = 'https://googleads.g.doubleclick.net/pagead/viewthroughconversion/123456789/?guid=ON&script=0';
      img.onload = () => resolve(false);
      img.onerror = () => resolve(true);
      setTimeout(() => resolve(false), 2000);
    });

    if (isControlBlocked) {
       // Verificación final: ¿Hay internet?
       try {
         await fetch(window.location.origin, { method: 'HEAD', cache: 'no-store' });
         console.log('%c🛡️ SHIELD: Bloqueo de red confirmado (Google Tracking).', 'color: orange;');
         score += 2;
       } catch {
         // Es un problema de internet real
       }
    }

    // 5. Prueba de Red Principal (Adsterra)
    try {
      const controller = new AbortController();
      const adsterraDomain = document.body.getAttribute('data-adsterra-domain');
      if (adsterraDomain) {
        setTimeout(() => controller.abort(), 2500);
        await fetch(`https://${adsterraDomain}/invoke.js`, { 
          mode: 'no-cors', cache: 'no-store', signal: controller.signal 
        });
      }
    } catch {
      console.log('%c🛡️ SHIELD: Adsterra bloqueado.', 'color: orange;');
      score += 2;
    }

    // 6. Prueba de Red Secundaria (Monetag)
    try {
      const controller = new AbortController();
      setTimeout(() => controller.abort(), 2500);
      await fetch(`https://ai751.com/tag.min.js`, { 
        mode: 'no-cors', cache: 'no-store', signal: controller.signal 
      });
    } catch {
      console.log('%c🛡️ SHIELD: Monetag bloqueado.', 'color: orange;');
      score += 2;
    }

    console.log('%c🛡️ SHIELD: Puntaje Final: ' + score, 'color: yellow; font-weight: bold;');
    
    /**
     * Orion: Umbral de Tolerancia Alto (v2.1)
     * Dado el gran aumento de anuncios, solo bloqueamos si el score es >= 5.
     * Esto evita falsos positivos por micro-cortes o problemas con un solo proveedor.
     */
    return score >= 5;
  }

  async function initShield() {
    _isBlocked = await checkIntegrity();
    
    if (_isBlocked) {
      if (isReaderPage) {
        showWall();
      } else {
        const toast = document.getElementById('system-notification-toast');
        if (toast) toast.style.display = 'flex';
      }
    }
  }

  function showWall() {
    const wall = document.getElementById('app-shield-root');
    if (!wall) return;
    
    wall.style.setProperty('display', 'flex', 'important');
    
    const lock = () => {
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
      document.body.style.touchAction = 'none';
      document.body.style.position = 'fixed';
      document.body.style.width = '100%';
    };
    lock();

    document.addEventListener('touchmove', (e) => {
      if (wall.style.display === 'flex') e.preventDefault();
    }, { passive: false });
    
    setInterval(() => {
      if (wall.style.display === 'none' || !document.getElementById('app-shield-root')) {
        location.reload();
      }
      if (document.body.style.overflow !== 'hidden') lock();
    }, 1000);
  }

  if (document.readyState === 'complete') {
    initShield();
  } else {
    window.addEventListener('load', initShield);
  }

  document.getElementById('verify-shield-btn')?.addEventListener('click', () => location.reload());
</script>


<style>
  .site-verification-mask {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    z-index: 99999;
    display: flex;
    justify-content: center;
    align-items: center;
    backdrop-filter: blur(8px);
    padding: 1rem;
  }

  .premium-alert-inner {
    background: linear-gradient(180deg, #111 0%, #080808 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 32px;
    padding: 3rem 2.5rem;
    max-width: 440px;
    width: 100%;
    text-align: center;
    box-shadow: 0 30px 60px rgba(0,0,0,0.8);
    animation: cardAppear 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes cardAppear {
    from { opacity: 0; transform: translateY(30px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .wall-icon-container {
    background: radial-gradient(circle, rgba(0, 191, 255, 0.15) 0%, transparent 70%);
    width: 80px;
    height: 80px;
    border-radius: 24px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto 1.5rem;
    color: var(--accent-color);
    border: 1px solid rgba(0, 191, 255, 0.2);
  }

  h2 {
    color: #fff;
    margin: 0 0 1rem;
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .wall-body p {
    color: #888;
    line-height: 1.6;
    font-size: 1rem;
    margin-bottom: 2rem;
  }

  .wall-body strong { color: #fff; font-weight: 700; }

  .browser-tip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    padding: 0.8rem 1.25rem;
    border-radius: 16px;
    margin-bottom: 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .browser-tip p { margin: 0; font-size: 0.85rem; color: #aaa; }
  .browser-tip span { color: var(--accent-color); font-weight: 700; }
  .browser-tip svg { color: var(--accent-color); flex-shrink: 0; opacity: 0.8; }

  .btn-verify {
    background: #fff;
    color: #000;
    border: none;
    padding: 1.1rem;
    border-radius: 16px;
    font-weight: 900;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    width: 100%;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    box-shadow: 0 10px 20px rgba(255, 255, 255, 0.1);
  }

  .btn-verify:hover { 
    transform: translateY(-3px); 
    box-shadow: 0 15px 30px rgba(255, 255, 255, 0.2);
    background: var(--accent-color);
  }

  /* Toast Compact */
  .soft-notice-wrapper {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background: #0a0a0c;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: white;
    padding: 0.75rem 1.25rem;
    border-radius: 16px;
    z-index: 10000;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.9rem;
    box-shadow: 0 15px 35px rgba(0,0,0,0.6);
    max-width: 90vw; /* Astra: Permitimos expansion casi total */
    white-space: nowrap; /* Astra: Forzamos una linea si hay espacio */
    backdrop-filter: blur(10px);
  }

  @media (max-width: 600px) {
    .soft-notice-wrapper {
      white-space: normal;
      left: 20px;
      right: 20px;
      bottom: 20px;
      text-align: center;
      justify-content: center;
    }
  }

  .close-toast {
    background: none;
    border: none;
    color: #666;
    cursor: pointer;
    font-size: 1.2rem;
    padding: 0;
  }
</style>
